	move.l	(a2,d6.w),a2 |  [$617d: jsr    ,x] [direct_jump] to bank 3
	jsr	(a2)
* active wait until something is requested
* during this time, only the irq runs
l_617f:
	GET_DP_ADDRESS	task_pointer_0012       	| [$617f: ldx    task_pointer_0012]
	MOVE_W_TO_REG	a0,d2                         	| [...]
	GET_REG_ADDRESS	0,d2                   	| [$6181: ldd    ,x] get action number
	LOAD_D                                 	| [$6181: ldd    ,x] get action number
	asl.b	#1,d0                            	| [$6183: asla] times 2
	jcc	mainloop_6160                      	| [$6184: bcc    mainloop_6160] branch if positive
