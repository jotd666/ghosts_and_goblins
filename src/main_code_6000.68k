* < B: index
* > X: bank_address_4000+B*$40
compute_bank_address_from_b_6378:
	move.b	#0x40,d0                        	| [$6378: lda    #$40]
	jbsr	multiply_ab                       	| [$637a: mul]
	move.w	#bank_address_4000,d2           	| [$637b: ldx    #bank_address_4000]
	MAKE_D                                 	| [...]
	add.w	d1,d2                            	| [$637e: leax   d,x]
	rts                                    	| [$6380: rts]

compute_screen_start_address_6381:
	move.w	#0x280f,d4                      	| [$6381: ldu    #$280f]
	OP_R_ON_DP_ADDRESS	move,0xff,d1         | [$6384: ldb    $ff]
	BIT	#0x01,d1                           	| [$6386: bitb   #$01]
	jeq	l_638e                             	| [$6388: beq    $638e]
	add.w	#0x0200,d4                       	| [$638a: leau   $0200,u] starts right half
l_638e:
	BIT	#0x20,d1                           	| [$638e: bitb   #$20]
	jeq	l_6395                             	| [$6390: beq    $6395]
	add.w	#0x10,d4                         	| [$6392: leau   $10,u] starts bottom half
l_6395:
	rts                                    	| [$6395: rts]

l_6396:
	GET_REG_ADDRESS	-0xd,d2                	| [$6396: ldb    -$d,x]
	move.b	(a0),d1                         	| [...]
	asl.b	#1,d1                            	| [$6398: aslb]
	.ifndef	RELEASE
	move.w	#0x639e,d4             	| [$6399: ldu    #0x639e]
	.endif
	lea	jump_table_639e,a4             	| [$6399: ldu    #jump_table_639e]
	JMP_B_INDEXED	a4,7  | [$639c: jmp    [b,u]] [indirect_jump] [nb_entries=7]



