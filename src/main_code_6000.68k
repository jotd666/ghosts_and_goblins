	VIDEO_WORD_DIRTY | [...]
	GET_REG_SELECT_ADDRESS	0x6,d3                 	| [$636f: ldb    $6,y] [select_address]
	move.b	(a0),d1                         	| [...]
	GET_REG_SELECT_ADDRESS	0x7,d3                 	| [$6371: lda    $7,y] [select_address]
