* < A: value
* < B: divisor
* > A: result
* > B: remainder
* if B==0, then returns B=1, A=$FF
divide_fed8:
	and.w	#0xFF,d1
	jne	0f
* avoid zero divide, follow original code behaviour
	st.b	d0
	moveq	#1,d1
	rts
0:
	divu	d1,d0
	swap	d0
	move.w	d0,d1
	clr.w	d0
	swap	d0
	rts
	rts                                    	| [$feef: rts]

* < pushed on U: value to divide
* < D: divisor
* > D: remainder of (U)/D
* if D==0, then word in U becomes FFFF
divmod_fef0:
	GET_REG_ADDRESS	0,d4   | get pushed address
	MOVE_W_TO_REG	a0,d6   | put to scratch register
	jne	0f
* avoid zero divide, follow original code behaviour
	move.w	#-1,d1
	MOVE_W_FROM_REG	d1,a0
	moveq	#0,d0
	move.b	#0x20,d1  | relevant? whatever
	rts
0:
	divu	d1,d6   | divide
	exg	d1,d6
	MOVE_W_FROM_REG	d1,a0 | store the result of the division
	clr.w	d1     | clear the result
	swap	d1      | swap to get the remainder
	rts                                    	| [$ff10: rts]

