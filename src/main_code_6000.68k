	GET_REG_UNCHECKED_ADDRESS	0x20,d4                	| [$6364: std    $20,u] [unchecked_address]
	MOVE_W_FROM_REG	d1,a0                         	| [...]
	GET_REG_SELECT_ADDRESS	0x4,d3                 	| [$6367: ldb    $4,y] [select_address]
	move.b	(a0),d1                         	| [...]
	GET_REG_SELECT_ADDRESS	0x5,d3                 	| [$6369: lda    $5,y] [select_address]
	move.b	(a0),d0                         	| [...]
