	.ifndef	RELEASE
	move.w	#0x6188,d2             	| [$6171: ldx    #0x6188]
	.endif
	lea	jump_table_6188,a2             	| [$6171: ldx    #jump_table_6188]
	moveq	#0,d6                            	| [...]
	move.b	d0,d6                           	| [...] as byte
	DO_EXTB	d6                             	| [...] with sign extension
	add.w	d6,d6 |  [$6174: ldx    a,x]
* set bank 3 before jump to it
	move.b	#0x03,d0                        	| [$6176: lda    #$03]
	OP_W_ON_DP_ADDRESS	move,bankswitch_copy_d9,d0| [$6178: sta    bankswitch_copy_d9]
