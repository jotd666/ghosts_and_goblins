	moveq	#0,d6                            	| [...]
	move.b	d0,d6                           	| [...] as byte
	DO_EXTB	d6                             	| [...] with sign extension
	GET_REG_ADDRESS_FROM_REG	d6,d4         	| [$fd4a: ldu    a,u]
	MOVE_W_TO_REG	a0,d4                         	| [...]
	rts                                    	| [$fd4c: rts]

