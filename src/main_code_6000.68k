write_4_bg_tiles_633f:
* set bank 0
	move.b	#0x00,d1                        	| [$633f: ldb    #$00]
	OP_W_ON_DP_ADDRESS	move,bankswitch_copy_d9,d1| [$6341: stb    bankswitch_copy_d9]
