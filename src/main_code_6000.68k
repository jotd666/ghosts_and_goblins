* each time coin is inserted, this is called to display a different
* background pic showing parts of level 1
* it's also used to setup a new level screen
change_background_62ab:
	move.l	d4,-(sp)                        	| [$62ab: pshs   u] save U
* there are 4 possible background screen locations picked at random
* 4000: start, 4004, 400A: forest, 4006: ground/river
	GET_DP_ADDRESS	background_screen_location_006c	| [$62ad: ldx    background_screen_location_006c]
	MOVE_W_TO_REG	a0,d2                         	| [...]
	move.b	#0x02,d1                        	| [$62af: ldb    #$02]
	OP_W_ON_DP_ADDRESS	move,bankswitch_copy_d9,d1| [$62b1: stb    bankswitch_copy_d9]
	exg	d0,d1
	jbsr	osd_set_bank |  [$62b3: stb    bankswitch_3e00]
	exg	d0,d1
	GET_REG_BANK_ADDRESS	0,d2                   	| [$62b6: ldb    ,x] [bank_address]
	move.b	(a0),d1                         	| [...]
	jbsr	l_6309                            	| [$62b8: bsr    $6309]
	GET_DP_ADDRESS	background_screen_location_006c	| [$62ba: ldd    background_screen_location_006c]
	LOAD_D                                 	| [$62ba: ldd    background_screen_location_006c]
	subq.b	#1,d1                           	| [$62bc: decb]
	PUSH_SR
	MAKE_D                                 	| [...]
	move.w	d1,d2                           	| [$62bd: tfr    d,x]
	POP_SR
	move.b	#0x02,d1                        	| [$62bf: ldb    #$02]
	OP_W_ON_DP_ADDRESS	move,bankswitch_copy_d9,d1| [$62c1: stb    bankswitch_copy_d9]
	exg	d0,d1
	jbsr	osd_set_bank |  [$62c3: stb    bankswitch_3e00]
