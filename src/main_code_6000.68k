	MAKE_A                                 	| [...]
	MAKE_D                                 	| [...]
	move.w	d1,d3                           	| [$6351: tfr    d,y]
	POP_SR
* set bank 1
	move.b	#0x01,d1                        	| [$6353: ldb    #$01]
	OP_W_ON_DP_ADDRESS	move,bankswitch_copy_d9,d1| [$6355: stb    bankswitch_copy_d9]
	exg	d0,d1
	jbsr	osd_set_bank |  [$6357: stb    bankswitch_3e00]
	exg	d0,d1
* this part will need optimization
	GET_REG_SELECT_ADDRESS	0,d3                   	| [$635a: ldb    ,y] [select_address]
	move.b	(a0),d1                         	| [...]
	GET_REG_SELECT_ADDRESS	0x1,d3                 	| [$635c: lda    $1,y] [select_address]
