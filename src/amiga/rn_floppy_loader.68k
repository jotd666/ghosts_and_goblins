	.include	"hardware/cia.i"
	.include	"hardware/custom.i"
	
	.global	rn_file_operation
	
* Rob Northen standard disk floppy loader
* ripped from various games

ciab_cra = CIAB+CIACRA
ciab_talo = CIAB+CIATALO
ciab_tahi = CIAB+CIATAHI
ciaa_pra = CIAA+CIAPRA
ciab_prb = CIAB+CIAPRB

_custom = 0xdff000

* < D0: command: 0: read
* < A0: filename (DFx:filename)
* < A1: destination address
* > D0: 0 (ok)
* > D1: filesize (not returning that leads to strange bugs...)

