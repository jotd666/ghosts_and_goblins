	.error	"NB_PLAYFIELD_PLANES must be defined via --defsym"
	.endif


* proportional to the number of bitplanes
BLITTER_LIST_SIZE = 10000*NB_PLAYFIELD_PLANES
COPPER_NOP = 0x1FE

START_X = 0
START_Y = 0
CORKSCREW_NB_SCREENS = 20
BORDERBLANK = 1
START_HOST_SCROLL_X = (CORKSCREW_NB_SCREENS/2)*0x100


PREVIOUS_SPRITE_SIZE = 8
CURRENT_SPRITE_SIZE = 4
COLUMN_SIZE = 0x20
ROW_SIZE = 0x10
GAME_MAX_SCROLL_X = 0x200
GAME_MAX_SCROLL_Y = 0x200
BG_TILE_WIDTH = 16

BG_TILE_FILE_MAX_SIZE = 0x14000
SPRITE_FILE_MAX_SIZE = 0x1F000
*SPRITE_FILE_MAX_SIZE = 0x1C800   | 8k smaller without the white arremers

	.if		OPT_CD32_VERSION==0
BIGGEST_MUSIC_SIZE = 385000
OPT_SPRITE_MIRRORING = 1
	.else
