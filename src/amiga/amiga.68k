		.text


	    
_user:
    * if D0 contains "WHDL"
    * A0 contains resload
        
    cmp.l   #0x05748444c,D0	| WHDL
    bne.b   .standard
	move.b	d1,_keyexit
    move.l a0,_resload

	move.l	a0,a2
	lea	(_tag,pc),a0
	jsr	(resload_Control,a2)
	
    bra		.no_forbid
.standard:
	
    * open dos library, graphics library
    move.l  0x4.W,a6
    lea dosname,a1
    moveq.l #0,d0
    jsr _LVOOpenLibrary(a6)
    move.l  d0,_dosbase

	lea	read_args_string(pc),a0
	lea	program_args(pc),a1
	move.l	#program_args_end-program_args,d0
	lsr.l	#2,d0		| number of longs
	

	bsr	get_args_BCPL

0:	
	lea		program_args,a0

	move.l	(A0)+,D0	| INVINCIBLE/S
	beq.b	1f
	or.l	#1,cheat_flags
	st.b	cheat_used
1:
	move.l	(A0)+,D0	| INFLIVES/S
	beq.b	2f
	or.l	#2,cheat_flags
	st.b	cheat_used
2:
	move.l	(A0)+,D0	| CHEATKEYS/S
	beq.b	2f
	* cheat isn't used as long as no cheat key is used
	or.l	#0x10,cheat_flags
2:



	lea		_custom,a5
	lea		debug_copperlist,a0
	move.l	a0,cop1lc(a5)

* no multitask
	
	move.l	4.W,A6
	* system-friendly PAL/NTSC detect
	cmp.b #50,0x212(a6)		| vblankfrequency
	jeq	0f
	* set NTSC
	move.l	#NTSC_MONITOR_ID,monitor
0:
	lea graphicsname,a1
    moveq.l #0,d0
    jsr _LVOOpenLibrary(a6)
    move.l  d0,_gfxbase
    move.l	d0,a6
	move.l	38(a6),old_syscoplist
	move.l	34(A6),old_actiview		| gb_ActiView

	sub.l	a1,a1
	jsr	_LVOLoadView(a6)
	jsr	_LVOWaitTOF(a6)
	jsr	_LVOWaitTOF(a6)
	
	*jbsr		load_highscores
    * check if "floppy" file is here
    move.l  _dosbase(pc),a6
    move.l   #floppy_file,d1
    move.l  #1005,d2   | MODE_OLDFILE
    jsr     _LVOOpen(a6)
    move.l  d0,d1
    beq.b   .no_floppy
    * "floppy" file found
    jsr     _LVOClose(a6)
    * wait 2 seconds for floppy drive to switch off
    move.l  #100,d1
    jsr     _LVODelay(a6)
.no_floppy:

* no multitask
	
    move.l  4,a6
    jsr _LVOForbid(a6)

    
	sub.l	A1,A1
	jsr	_LVOFindTask(a6)		| find ourselves
	move.l	D0,A0
	move.l	#-1,184(A0)	| pr_WindowPtr: no more system requesters (insert volume, write protected...)

.no_forbid:
	.ifne	OPT_ENABLE_LOGGING
	* protection for end of cpu log buffer
	lea		log_buffer_end,a0
	move.l	#0xCAFECAFE,d0
	.rept	4
	move.l	d0,(a0)+
	.endr
	.endif


	* dummy copperlist with no bitplanes enabled
	lea		_custom,a5
	lea		debug_copperlist,a0
	move.l	a0,cop1lc(a5)
	


	move.l	cheat_flags,d0
	jeq		1f
	btst	#0,d0
	sne		invincible_flag
	btst	#1,d0
	sne		infinite_lives_flag
	btst	#2,d0
	sne		infinite_time_flag
	btst	#3,d0
	sne		skip_first_loop_flag
	move.b	d0,d1
	and.b	#3,d1
	jeq		2f
	* cheat key disable highscore only if used
	st.b	cheat_used
2:


0:
1:	
	
	move.b	start_level+3,start_level_flag
	
	* default is 25Hz, game crawls at 50Hz unless on pistorm
	move.l	misc_options,d1
	btst	#0,d1
	seq		frameskip
	btst	#1,d1
	sne		skip_intro_flag
	btst	#2,d1
	sne		no_level_music_flag
	btst	#3,d1
	sne		service_mode_flag
	.ifne	OPT_CD32_VERSION
	* force the flag
	st		no_level_music_flag
	.endif


	move.l	cheat_flags,d0
	btst	#0,d0
	beq.b	0f
	st		cheat_used
0:
	btst	#1,d0
	beq.b	0f
	st		cheat_used
0:
	btst	#2,d0
	beq.b	0f
	st		cheat_used
0:
	move.l	cheat_flags,d0
	btst	#3,d0
	beq.b	0f
	st		cheat_used

0:
	* set dip switches
	* (some settings are not modifiable)
	move.b	#0x20,d0	| demo sounds on
	tst.b	service_mode_flag
	jeq		0f
	bset	#6,d0
0:
	not.b	d0
	move.b	d0,dip_switches_1

	lea		lives_table,a0
	move.b	start_lives+3,d1
	and.w	#3,d1
	move.b	(a0,d1.w),d0


	lea		difficulty_table,a0
	move.b	difficulty_level+3,d1
	and.w	#3,d1
	move.b	(a0,d1.w),d1
	lsl.b	#4,d1
	or.b	d1,d0
	not.b	d0
	move.b	d0,dip_switches_2
	
	jsr	 _detect_controller_types

	jra		demo_game

	.ifndef	RELEASE
display_text:
0:
	move.b	(a1)+,d1
	jmi		1f
	move.b	d1,(a0)
	move.b	d0,(0x400,a0)
	jbsr	osd_video_byte_dirty
	addq	#1,a0
	jra		0b
1:
	rts

	
* < A1: address
* < D0: number
num2hexstring:
	movem.l	d0-a6,-(a7)
	moveq	#3,d4		| nb digits
	move.l	#0xF000,D3
	moveq.l	#4,D2
	move.b	#'x',(A1)+	
.loop:
	move.w	D0,D1
	and.w	D3,D1
	rol.w	D2,D1
	cmp.b	#9,D1
	bgt	.letter
	**add.b	#'0',D1		| in this charset no need to add '0'
	move.b	D1,(A1)+
	bra	.loopend
.letter:
	add.b	#'A'-10,D1
	move.b	D1,(A1)+
.loopend:
	addq.l	#4,D2
	lsr.l	#4,D3
	dbf	D4,.loop
	st.b	(a1)
	movem.l	(a7)+,d0-a6
	rts
	
* < A0: address
* < D0: color
* < D1: value 16 bit
display_number:
	lea		(-8,a7),a7
	move.l	a7,a1
	exg	d0,d1
	jbsr	num2hexstring
	exg	d0,d1
	jbsr	display_text
	lea		(8,a7),a7
	rts
	
	
	.endif
	
* so memory is quadword-aligned (not trusting .align directives)
align_for_fmode:
	.ifne	OPT_AGA_MODE
	add.w	#0x8,a0
	move.l	a0,d0
	and.b	#0xF8,d0
	move.l	d0,a0
	.endif
	rts
	
* < D0: bcpl string (with leading size byte)
* < A1: dest C string
bcpl_arg_string_copy:
    movem.l D0-D2/A0-A1,-(a7)
	lsl.l	#2,d0
	moveq.l	#0,d2
    move.l  d0,a0
	move.b	(a0)+,d2	| size
	beq.b	1f
	subq	#1,d2
0:
	move.b	(a0)+,(a1)+
	dbf		d2,0b
1:
    movem.l (a7)+,D0-D2/A0-A1
    rts


bcpl_string_to_int:
    movem.l A0/A1,-(a7)
    lea temp_filename_buffer(pc),a1
    bsr bcpl_arg_string_copy
    * convert to integer
    move.l  a1,a0
    * < A0: pointer on C string
    * > D0: value
    * > D1: -1 if ok, position of the string if error
    bsr parse_integer
    movem.l  (a7)+,a0/a1
	rts
	
* parse integer from string
* < A0: pointer on C string
* > D0: value
* > D1: -1 if ok, position of the string if error
parse_integer:
    movem.l  d2/d3,-(a7)
    * go to end of string
    moveq.l #-1,d1
.loop1:
    addq.l  #1,d1
    tst.b   (a0,d1.w)
    bne.b   .loop1
    * d1 is the number of chars
    moveq.l #0,d0
    moveq.l #0,d2
    subq.l  #2,d1   | 10th power minus 1
.loop2:
    move.b  (a0)+,d2
    beq.b   .out
    
    cmp.b   #32,d2
    beq.b   .sk
    sub.b   #48,d2
    bcs.b   .error
    cmp.b   #10,d2
    bcc.b   .error
    move.w  d1,d3
    bmi.b   .doadd
.muloop:
    mulu    #10,d2
    dbf d3,.muloop
.doadd:
    add.l   d2,d0
.sk:
    subq.l  #1,d1
    bra.b   .loop2
.out:    
    movem.l  (a7)+,d2/d3
    rts
.error:
    moveq.l #0,d0
    bra.b   .error
	
    * thanks Toni for this 1.3 read argument code
BCPL_RdArgs = 78
	
	* a1 = pointer to result array. Must be LONG aligned!
	* a0 = formatting string. BSTR!
	* d0 = size of result array (number of LONGs)
get_args_BCPL:
	movem.l d2/d3/d4,-(sp)
	move.l d0,d3
	moveq #BCPL_RdArgs,d0
	move.l a0,d1
	lsr.l #2,d1
	move.l a1,d2
	lsr.l #2,d2
	moveq #0,d4
	bsr.s call_bcpl
	movem.l (sp)+,d2/d3/d4
	rts

	* d0 = gv index
	* d1-d4 = bcpl parms

BCPL_STACK = 3000

call_bcpl:
	movem.l d2-d7/a2-a6,-(sp)

	move.l d0,d6
	move.l d1,d5

	move.l 4.w,a6
	move.l	_dosbase(pc),a5


	sub.l a1,a1
	jsr	_LVOFindTask(a6)
	move.l d0,a4

	* allocate BCPL stack
	move.l #BCPL_STACK,d0
	move.l #65536+1,d1
	jsr	_LVOAllocMem(a6)
	move.l d0,d7
	beq.s 0f
	
	movem.l d7/a5/a6,-(sp)

	moveq #0,d0
	move.l d5,d1
	sub.l a0,a0
	move.l d7,a1
	lea 3*4(a1),a1
	move.l 136(a4),a2
	add.w	d6,d6
	add.w	d6,d6
	move.l 0(a2,d6.w),a4
	movem.l 46(a5),a5/a6
	jsr (a5) | call bcpl!
	
	movem.l (sp)+,d7/a5/a6

0:
	move.l d7,a1
	move.l #BCPL_STACK,d0
	jsr	_LVOFreeMem(a6)


	movem.l (sp)+,d2-d7/a2-a6
	rts




demo_game:
		move		#0x4000,_custom+intena						| disable interrupts
		move		#0x7FFF,_custom+intreq						| ack all interrupts
		bsr			platform_init					| amiga-specific init
		
0:	
	.ifne	OPT_ALIGNED_MEMORY
	* compute ram start for dev mode
	* align so real addresses LSW match actual arcade addresses
	* and lower 16-bit match original RAM & even ROM offsets
	*

	lea		dev_ram_buffer,a6
	move.l	a6,d0
	clr.w	d0
	move.l	d0,d1
	add.l	#0x10000+RAM_START,d1
	move.l	d1,ram_start_0000		| memory (0x1000-0xFFFF)
	
	* relocate rom tables just after shared RAM
	* memory is contiguous (only 1 segment of memory RAM+ROM)
	* and 6809 memory access is way faster (no bank switching)
	
	* copy the ROM data
	add.l	#ROM_START-RAM_START,d1
	move.l 	d1,a1
	move.w	#(0x10000-ROM_START)/4-1,d0
	.else
	* release mode

	* copy the ROM data after RAM
	lea		rom_buffer,a1
	move.w	#(0x10000-ROM_START)/4-1,d0
	.endif
	
	lea		rom_base,a0
0:
	move.l	(a0)+,(a1)+
	dbf		d0,0b
	* change copyright message "all right reseved"
	lea	bank3_4000+0x9B1,A1
	lea	copyright_message,a0
0:
	move.b	(a0)+,(a1)+
	jne		0b
	
	lea	bank3_4000,A1
	move.b	#0x53,(0xEFA,a1)		| fix "PROGRES"
	move.b	#0x45,(0xF80,a1)		| fix "STRONGTH"
	* change bogus message to "YOU FEEL STRENGTH WELLING UP IN YOU"
	lea		(0xF90,a1),a0
	move.l	#0x0B555020,(a0)+
	move.l	#0x494E2059,(a0)+
	move.l	#0x4F552020,(a0)+
	move.b	#0x20,(a0)
	
	* install bank 4 in 0x4000, we may as well use that space
	* plus it allows simpler code ex at 9088 where game accesses
	* ROM or bank ROM in bank 4

	GET_MEMORY_START_AND_DP
	jbsr	install_bank_4
	
	
	.ifndef	RELEASE
	* install dump and quit handler
	pea		dump_and_quit
	lea		2.W,a0
	move.l	#0x4AFC4EF9,(a0)+
	move.l	(a7)+,(a0)+
	.endif
	


	* enable interrupts. Game doesn't use them
	* but relies on vbl sync flags
	jbsr	cpu_init		| zero most registers
	moveq	#0,d5			| D5 too
	
	jbsr	cache_fg_tiles_address
	jbsr	cache_bg_tiles_address

	* load level 1 music
	.ifeq	OPT_CD32_VERSION
	lea		level_12_music,a0
	.else
	lea		cd32_music,a0
	.endif
	move.l	a0,current_music_name
	lea		module_buffer,a1
	move.l	#BIGGEST_MUSIC_SIZE,d0
	jbsr	load_file
	
	tst.b	no_level_music_flag
	jeq		0f
	jbsr	make_automatic_sound_channels
0:
	* create mirror parts for common sprites
	* first initialize buffer address
	.ifne		OPT_SPRITE_MIRRORING
	move.l	#mirror_buffer,mirror_buffer_ptr
	jbsr	mirror_common_sprites
	.endif
	
	moveq	#0,d0
	jbsr	osd_set_bank
	GET_MEMORY_START_AND_DP	
	jmp		reset_6000								| pass control to the mpatrol core
	
	.ifne	OPT_SPRITE_MIRRORING
mirror_common_sprites:
	lea		shared_bob_table,a0
	move.w	#0x3FF,d7
0:
	move.l	(a0)+,d0
	jeq		100f
	* sprite here, get clut table
	move.l	d0,a1
	move.w	#SPRITE_NB_CLUTS-1,d6
1:
	move.l	(a1)+,d1
	jeq		2f
	* clut exists
	move.l	d1,a3
	lea		((NB_PLAYFIELD_PLANES+1)*4+8,a3),a2
	cmp.w	#-2,(a2)
	jeq		2f
	* we must generate mirrored data
	jbsr	compute_mirror_bitplanes
2:
	dbf		d6,1b
100:
	dbf		d7,0b
	* set top address as base for contextual mirror data
	move.l	mirror_buffer_ptr,mirror_buffer_context_ptr
	rts
	
* < A2: bitplane pointer list to fill
* < A3: original bitplane pointers (with headers)
	
compute_mirror_bitplanes:
	movem.l	d0-a6,-(a7)
	* mirror exists: must first copy the bitplane data above
	* a3 points on dimensions
	* compute memory needed to clone the bitmap
	move.l	mirror_buffer_ptr,a0
	move.w	(a3)+,d4		| height
	move.w	d4,d6 			| save height in d6
	move.w	(a3)+,d5		| width in bytes + 2
	addq	#4,a3			| skip rest to point on source bitplanes
	subq	#2,d5			| adjust to real data width
	mulu	d5,d4			| size of bitplane data
	addq	#2,d5		    | make up
	move.w	#NB_PLAYFIELD_PLANES-1+1,d3  | mask!!
	mulu	d4,d3			| size of data to allocate

	* first copy data so we can use in-place mirror routines (a bit wasteful but
	* not a big issue as this happens at level start)
	
	move.w	#NB_PLAYFIELD_PLANES-1+1,d3  | mask!!
100:
	move.l	(a3)+,d1
	jne		101f
	* null source bitmap
	clr.l	(a2)+
	jra		2f		| next bitplane
101:
	move.l	d1,a1		| get bitplane data
	move.l	a0,(a2)+		| store it
	move.w	d4,d0
	lsr.w	#1,d0
	subq	#1,d0
	* copy data
1:
	move.w	(a1)+,(a0)+
	dbf		d0,1b
	* check (too late) if the buffer overflowed. It will overflow on restore buffer so no risk of crashing
	* just detect it and stop
	.ifndef	RELEASE
	cmp.l	#mirror_buffer_end,a0
	jcs		0f
	BREAKPOINT	"mirror buffer too small"
	illegal
0:
	.endif
2:
	dbf		d3,100b
	move.l	a0,mirror_buffer_ptr	| update for next time
	* reset pointer, start mirroring
	lea		((-NB_PLAYFIELD_PLANES-1)*4,a2),a0
	move.w	#NB_PLAYFIELD_PLANES-1+1,d3  | mask!!
	lea		mirror_table,a1
	lea		mirror_function_table,a3
	.ifndef	MC68020
	move.w	d5,d0       | number of byte values (4: 16 bits + shifting)
	add.w	d0,d0
	move.l	(a3,d0.w),a3
	.else
	move.l	(a3,d5.w*2),a3		| compute mirror function once and for all
	.endif
0:
	move.w	d6,d1		| height
	subq	#1,d1		| minus one for dbf
	move.l	(a0)+,d0	| bitplane data
	jeq		1f
	move.l	d0,a2
	jsr		(a3)		| perform in-place mirror
1:
	dbf		d3,0b

	movem.l	(a7)+,d0-a6
	rts
	.else
compute_mirror_bitplanes:
	rts
	.endif

copyright_message:
	*.asciz	"ALL RIGHT RESEVED"
	 .asciz	"AMIGA PORT : JOTD"

	.ifndef	RELEASE
dump_and_quit:	
	jbsr	osd_dump_logs
	illegal
	.endif

make_automatic_sound_channels:
	* if music is off, set most sounds in automatic channel
	lea		sound_table,a0
	moveq	#0,d1
1:
	st	d2
	* skip those, leave in fixed channel else they saturate the channels
	cmp.w	#SHOT_FIRED_06_SND,d1
	jeq		0f
	cmp.w	#ENEMY_HIT_1A_SND,d1
	jeq		0f
	cmp.w	#SHIELD_FLYING_1F_SND,d1
	jne		2f
	move.b	#1,d2		| switch to channel 1
2:
	move.w	(a0),d0
	cmp.w	#1,d0
	jne		0f
	move.l	(4,a0),a1	| pointer on sound
	
	move.b	d2,(10,a1)	| change sound channel
0:
	add.w	#8,a0		| sound entry size
	addq	#1,d1
	cmp.w	#0x3F,d1
	jne		1b
	rts

osd_black_colors:
	lea		sprite_palette,a0
	move.l	color_copper_pointers,a1	| tile entries 0-32
	move.w	#TOTAL_NB_COLORS/2-1,d0
1:
	addq.w	#2,a1
	clr.w	(a1)+
	dbf		d0,1b
2:
	rts

	
* called when continue timer reaches 0: time to load context 1 else tiles will be trashed in the title
* < A0: shadow ram palette
osd_no_continue_hook:
	clr.b	(current_level_0072,a6)		| doesn't matter for the game but it matters for the context
	jbsr	osd_set_tile_palette
	rts
	
osd_colors_cycled:
* < A0: tile palette in RAM (but shadows hardware palette)
* format (RGB4) is: offset=$RG, offset+$40=$B0
* I imagine that on NeoGeo we just set the palette and so be it but here we have eliminated
* duplicate entries for tiles and were lucky enough on level 1 for instance to keep the exact unique
* colors for the tiles. So the RGB values used are the same as in the game, but the game uses 4 slots
* and we only have 3 slots. We'll have to adapt I doubt it will be noticeable
	OSD_ENTER
	movem.l	d0-a6,-(a7)
	GET_MEMORY_START_IN_A6
	move.b	(current_level_0072,a6),d0
	jne		0f
	* graveyard, get 2 first palette entries
	move.w	#0x2A,d0
	move.b	(a0,d0.w),d2
	lsl.w	#8,d2
	move.b	(0x40,a0,d0.w),d2
	swap	d2
	move.w	#0x2B,d0
	move.b	(a0,d0.w),d2
	lsl.w	#8,d2
	move.b	(0x40,a0,d0.w),d2
	* we track 3 values (there are 4 possibilities actually)
	moveq	#0,d0
	cmp.l	#0x059008A0,d2
	jeq		1f
	moveq	#6,d0
	cmp.l	#0x08A008A0,d2
	jeq		1f
	*cmp.l	#0x08A00590,d2
	moveq	#12,d0
1:
	lea		water_color_table,a2
	jbsr	cycle_colors
	jra		10f
0:
	cmp.b	#3,(current_level_0072,a6)		| bridge
	jne		10f
	* bridge
	move.w	#0x21,d0
	move.b	(a0,d0.w),d2
	lsl.w	#8,d2
	move.b	(0x40,a0,d0.w),d2
	swap	d2
	move.w	#0x23,d0
	move.b	(a0,d0.w),d2
	lsl.w	#8,d2
	move.b	(0x40,a0,d0.w),d2
	move.w	#0x23,d0
	move.b	(a0,d0.w),d2
	lsl.w	#8,d2
	move.b	(0x40,a0,d0.w),d2


	* there are 3 possibilities
	moveq	#0,d0
	cmp.l	#0xA030A030,d2	| first color combo
	jeq		1f
	moveq	#8,d0
	cmp.l	#0xA030,d2
	jeq		1f
	moveq	#16,d0
	*cmp.l	#0xA0300000,d2
	*jeq		1f
1:
	lea		bridge_color_table,a2
	jbsr	cycle_colors	
10:
	movem.l	(a7)+,d0-a6
	OSD_EXIT
	rts

cycle_colors:
	* change some colors (water animation in level 1)
	lea		dyn_color_indexes,a0
	add.w	d0,a2
	lea		copperlist_colors+4,a1		| skip bplcon3
2:
	move.w	(a0)+,d0		| color index times 4
	jmi		3f
	move.w	(a2)+,d1
	move.w	d1,(2,a1,d0.w)		| change color in copperlist
	jra		2b
3:
	rts
	
* the color scheme is simplified compared to the original
* but it should work all right
water_color_table:
	.word	0x08A
	.word	0x059
	.word	0x6AC
	.word	0x059
	.word	0x08A
	.word	0x6AC
	.word	0x6AC
	.word	0x059
	.word	0x08A
bridge_color_table:
	.word	0xA03
	.word	0xC04
	.word	0xF50
	.word	0xF70
	
	.word	0xC04
	.word	0xA03
	.word	0xF70
	.word	0xF50
	
	.word	0xF70
	.word	0xF50
	.word	0x0
	.word	0xA03
	
	.word	0xF50
	.word	0x0
	.word	0xC04
	.word	0xF70

	          
* very important for the amiga version as it allows to detect level/context switches
* and load the relevant parts (we can't have everything in memory)
* on 68k non-amiga versions (if done one day) derived on this port, this could be much simpler.
* I imagine that on NeoGeo we just set the palette and so be it.

osd_set_tile_palette:
	OSD_ENTER
	movem.l	d0-a6,-(a7)
	* re-compose RGBx word to search in palette
	* if color are at the indicated positions, then we know
	* for sure what is the palette and thus what is the context
	move.w	unique_color_index,d0
	move.b	(a0,d0.w),d2
	lsl.w	#8,d2
	move.b	(0x40,a0,d0.w),d2
	
	lea		context_data,a1
	lsr.w	#4,d2
0:
	move.w	(a1)+,d0
	jmi		5f
	addq	#2,a1
	cmp.w	d0,d2
	jne		0b

	* we recognized our context
	* but actually it's way more complex as the game performs
	* dynamic color changes. Better rely on the level number
	* at this point, except for map context, which has priority
	move.w	(-2,a1),d0
	cmp.w	#MAP_CONTEXT,d0
	jeq		2f
	
	* level 3 or 4. Check the level number in RAM color to find out
	* as both levels share the exact same palette, but we want
	* a different context load as it's cleaner that way
	
	GET_MEMORY_START_IN_A6
	cmp.b	#2,(current_level_0072,a6)
	jeq		3f			| level 3 all right
	cmp.b	#3,(current_level_0072,a6)
	jne		1f
	moveq	#3,d0
	jra		2f			| level 4
3:
	moveq	#2,d0		| level 3
	jra		2f
1:
	
	move.w	(-2,a1),d0
	jne		1f
	* level 1 or 2. Check the level number in RAM color to find out
	* as both levels share the exact same palette, but we want
	* a different context load as it's cleaner that way
	GET_MEMORY_START_IN_A6
	tst.b	(current_level_0072,a6)
	jeq		2f			| level 1 all right
	addq	#1,d0
	cmp.b	#1,(current_level_0072,a6)
	jeq		2f			| level 2
	* neither level 1 or 2. Must have used a start level cheat
	* ignore the context load, it will load properly later
	jra		103f
1:

	
	cmp.w	#0x100,d0
	jcc		7f			| special context: palette change but no context load
2:
	jbsr	load_context
5:
	* reset palette
	move.l	bg_character_table_buffer_ptr,a0
6:
	move.l	color_copper_pointers,a1	| entries 0-31
	move.w	#TOTAL_NB_COLORS/2,d0
	jbsr	load_palette
	* locate interesting colors in palette for levels 1 and 4 (bridge) to color-cycle tiles
	move.l	bg_character_table_buffer_ptr,a0
	lea		dyn_color_indexes,a2
	lea		interesting_colors_level_1,a1
	tst.b	(current_level_0072,a6)
	jeq		10f
	lea		interesting_colors_level_4,a1	
10:
	moveq	#0,d0
	move.w	(a1)+,d2		| load first interesting color, look it up
100:

	move.w	(a0)+,d1
	cmp.w	d2,d1
	jne		101f
	* store index*4
	move.w	d0,(a2)+
	* load next interesting color
	move.w 	(a1)+,d2
	jmi		102f			| no more interesting color
	moveq	#0,d0
	* reset search
	move.l	bg_character_table_buffer_ptr,a0
	jra		100b
101:
	addq	#4,d0		| next index times 4
	cmp.w	#TOTAL_NB_COLORS*2,d0
	jne		100b
102:
	move.w	#-1,(a2)		| terminate list
103:
	movem.l	(a7)+,d0-a6
	OSD_EXIT
	rts
7:
	* palette change
	sub.w	#0x100,d0	
	lsl.w	#NB_PLAYFIELD_PLANES,d0  | half colors, 2 bytes per word
	lea		fade_palettes,a0
	add.w	d0,a0
	jra		6b
	
	
* < D0: context name
load_context:
	cmp.w	current_context,d0
	jne		0f
	* same context: don't load
	rts
0:
	movem.l	d0-a6,-(a7)
	jbsr	osd_disable_interrupts
	
	.ifne	OPT_ENABLE_LOGGING
	* reset logged tiles
	lea	bg_tile_log_table,a0
0:
	clr.l	(a0)+
	cmp.l	#bg_tile_log_table_end,A0
	jne	0b
	.endif
	
	* clear mirror buffer (reset it just after the shared bob mirror data)
	move.l	mirror_buffer_context_ptr,mirror_buffer_ptr

	move.w	current_context,previous_context
	move.w	d0,current_context
	cmp.w	#MAP_CONTEXT,d0
	jne		0f

	* map context: we should save previous context
	* and use that map context aleady in RAM
	move.w	previous_context,saved_context
	move.l	#bg_tile_palette,bg_character_table_buffer_ptr
	jra		30f
0:
	* is previous context map?
	cmp.w	#MAP_CONTEXT,previous_context
	jne		1f
	* coming from map: check if saved_context is the context we want
	cmp.w	previous_context,d0
	jne		1f   
	* the file buffer already contains the context, just set pointer
	move.l	#bg_character_table_buffer,bg_character_table_buffer_ptr
	jra		30f
1:
	lea	tile_context_name_table,A0
	add.w	d0,d0	
	add.w	d0,d0
	move.l	(a0,d0.w),a0
	move.w	#-1,saved_context   | cancel saved context
	clr.l	context_sprite_table_ptr		| "free" sprites too
	lea		bg_character_table_buffer,a1
	move.l	a1,bg_character_table_buffer_ptr
	move.l	#BG_TILE_FILE_MAX_SIZE,d0
	jbsr	load_file
	
	* now load the specific sprites for that level
	* there will be some repeats, but overall the memory footprint will be smaller
	* thus allowing pre-computed symmetric bitmaps
	cmp.w	#MAP_CONTEXT,d0
	jeq		2f
	move.w	current_context,d0
	lea	sprite_context_name_table,A0
	add.w	d0,d0	
	add.w	d0,d0
	move.l	(a0,d0.w),a0
	lea		sprite_table_buffer,a1
	move.l	a1,context_sprite_table_ptr
	move.l	#SPRITE_FILE_MAX_SIZE,d0
	jbsr	load_file
	* todo: copy the first level of pointers in fastmem (256*4: 1kb)
	jbsr	relocate_sprites_file
	
2:
	jbsr	relocate_tiles_file
30:
	* re-set pointer
	move.l	bg_character_table_buffer_ptr,a0
	lea		(TOTAL_NB_COLORS,a0),a0		| skip 32 color palette
	move.l	a0,bg_tile_character_table				| set character table pointer
	
	* optimize: should we mirror Y tiles? only in some contexts
	move.w	current_context,d0
	lea		mirror_y_tile_table,a0
	tst.b	(a0,d0.w)
	sne		must_mirror_y_tiles
	
	* if level 1 set (intro), pre-load level 12 music as may has been overwritten by highscore tune
	tst.w	current_context
	jne		0f
	move.w	#LEVEL12_TUNE_SND*8,d0
	jbsr	load_music_if_needed
0:
	* at start redraw everything
	move.w	#START_X,game_scroll_x
	move.w	#START_Y,game_scroll_y
	move.w	game_scroll_x,previous_scroll_x
	jbsr force_all_screen_redraw

	jbsr	osd_enable_interrupts

	movem.l	(a7)+,d0-a6
	rts
	
relocate_tiles_file:
	* now relocate the tile file
	move.l	bg_character_table_buffer_ptr,a0
	lea		(TOTAL_NB_COLORS,a0),a0		| skip 32 color palette
	move.l	a0,bg_tile_character_table				| set character table pointer
	move.l	a0,d0
	move.w	#BG_TILE_COUNT-1,d7
0:
	move.l	(a0)+,d1
	jeq		10f
	add.l	d0,d1
	move.l 	d1,(-4,a0)
	move.l	d1,a1

	* relocate pointers on bitplane list in clut table
	moveq	#BG_TILE_NB_CLUTS-1,d6
1:
	move.l	(a1)+,d2
	jeq		5f
	add.l	d0,d2
	move.l	d2,(-4,a1)
	move.l	d2,a2
	* relocate pointers on bitplanes
	moveq	#NB_BG_PLANES-1,D5	| 5 bitplanes
2:
	move.l	(a2)+,d3
	jeq		4f
	add.l	d0,d3
	move.l	d3,(-4,a2)
4:
	dbf		D5,2b
5:
	dbf		d6,1b
10:
	dbf		d7,0b
	rts
	

relocate_sprites_file:
	* now relocate the tile file
	move.l	context_sprite_table_ptr,a0
	move.l	a0,d0
	jne		0f
	rts
0:
	moveq	#0,d7
0:
	move.l	(a0)+,d1
	jeq		10f
	add.l	d0,d1
	move.l 	d1,(-4,a0)
	move.l	d1,a1

	* relocate pointers on bitplane list in clut table
	moveq	#SPRITE_NB_CLUTS-1,d6
1:
	move.l	(a1)+,d2
	jeq		5f
	add.l	d0,d2
	move.l	d2,(-4,a1)
	move.l	d2,a2
	* relocate pointers on bitplanes
	move.l	a2,a3		| store bitplane data with headers for later
	addq	#8,a2		| skip dimensions (else boom!)
	moveq	#NB_PLAYFIELD_PLANES-1+1,D5  | mask!!
2:
	move.l	(a2)+,d3
	jeq		4f
	add.l	d0,d3
	move.l	d3,(-4,a2)
4:
	dbf		D5,2b
	* finished processing bitplanes. Do we have to compute mirror bitplanes?
	cmp.w	#-2,(a2)
	jeq		5f
	* yes, we need to fill the data
*	cmp.w	#0x91,d7
*	jne		55f
*	BREAKPOINT	"trunk"
*55:


	jbsr	compute_mirror_bitplanes
5:
	dbf		d6,1b
10:
	addq	#1,d7
	cmp.w	#SPRITE_COUNT,d7  
	jne		0b
	rts
	


	
set_initial_scroll_values:
	move.w	game_scroll_x,d0
	move.w	d0,previous_scroll_x
	add.w	#START_HOST_SCROLL_X,d0			| give us some leeway to the left: 10 screens before havoc
	move.w	d0,host_scroll_x
	move.w	d0,min_scroll_x
	move.w	d0,d1
	add.w	#VISIBLE_SCROLL_WIDTH+BG_TILE_WIDTH,d1		| after that it triggers tile refresh
	move.w	d1,max_scroll_x
	rts
	
force_all_screen_redraw:
	lea		_custom,a5
	REALLY_WAIT_BLIT
	GET_MEMORY_START_IN_A6
	* given the current scroll X/Y, draw all tiles on screen
	jbsr	set_initial_scroll_values
	
	move.w	host_scroll_x,d0
	
	move.w	d0,d5				| save scroll X
	lea		(bg_tiles_address_2800,a6),a5
	move.w	game_scroll_x,d0
	lsr.w	#4,D0	| divide by 16 to get real X tile offset
	* now compute start address to fetch data from
	move.w	#0,d7
	* atm Y=0
	lsl.w	#5,d0	| times 32
	add.w	d0,d7	| start address

	move.w	d7,d6	| save current Y

	move.w	#0x10,d2	| size of screen in tiles
0:
	move.w	d6,d7	| set current Y row
	move.w	#COLUMN_SIZE-1,d1		|  (64 bit margin)
1:
	* compute X offset now align on 0x40
	move.w	d5,d0
	lsr.w	#8,d0
	lsr.w	#1,d0
	lsl.w	#6,d0
	move.w	d0,x_offset
	and.w	#0x3FF,d7		| wrap on memory
	* force tile draw
	lea		(a5,d7.w),a0

	movem.l	d1-d2/d5-d6,-(a7)
	move.b	(a0),d0
	move.b	(0x400,a0),d1
	jbsr	update_bg_tile	
	movem.l	(a7)+,d1-d2/d5-d6
	
	add.w	#0x1,d7		| next X
	dbf		d1,1b
	add.w	#0x20,d6
	add.w	#BG_TILE_WIDTH,d5	| keep track of current "scroll"
	dbf		d2,0b
	clr.w	x_offset
	rts
	
	
draw_left_tiles:
	move.w	min_scroll_x,d0
	sub.w	#BG_TILE_WIDTH,d0		| else refresh will be okay but visible
	jra		draw_column_tiles
draw_right_tiles:
	move.w	max_scroll_x,d0

draw_column_tiles:
	* compute X offset
	move.w	d0,-(a7)
	lsr.w	#8,d0
	lsr.w	#1,d0
	lsl.w	#6,d0	
	move.w	d0,x_offset
	move.w	(a7)+,d0	
	GET_MEMORY_START_AND_DP

	lea		(bg_tiles_address_2800,a6),a5
	lsr.w	#4,D0	| divide by 16 to get real X tile offset
	* now compute start address to fetch data from
	move.w	#0,d7		| first row is not visible with scroll=0, visible with=$10
	* atm Y=0
	lsl.w	#5,d0	| times 32
	add.w	d0,d7	| start address

	move.w	#COLUMN_SIZE-1,d2
0:
	and.w	#0x3FF,d7		| wrap
	* force tile draw
	lea		(a5,d7.w),a0
		
	move.b	(a0),d0
	move.b	(0x400,a0),d1

	move.w	d2,-(a7)
	jbsr	update_bg_tile
	move.w	(a7)+,d2
	
	addq	#1,d7			| next Y
	dbf		d2,0b
	rts

set_scroll_values:
	* update host scroll
	* handle 2 wrap points
	move.w	game_scroll_x,d0
	move.w	previous_scroll_x,d1
	move.w	d0,d2
	sub.w	d1,d2		| d2: diff between game scroll before / after
	
	cmp.w	#GAME_MAX_SCROLL_X-BG_TILE_WIDTH,d0
	jcs		0f
	* game scroll X >= 0x1F0
	cmp.w	#BG_TILE_WIDTH,d1
	jcc		0f
	* previous scroll X < 0x10: wrap left
	sub.w	#GAME_MAX_SCROLL_X,d2
	jra		1f
0:
	cmp.w	#BG_TILE_WIDTH,d0
	jcc		1f
	* game scroll X < 0x10
	cmp.w	#GAME_MAX_SCROLL_X-BG_TILE_WIDTH,d1
	jcs		1f
	* previous scroll X > 0x1F0: wrap right
	add.w	#GAME_MAX_SCROLL_X,d2
1:

0:
	* now let's check absolute value of scroll diff
	move.w	d2,d3
	jpl	2f
	neg.w	d3
2:
	cmp.w	#BG_TILE_WIDTH*2,d3
	jcs		3f
	* before/after diff is too big: redraw all
	* note that this screws the column updates if triggered
	* from somewhere else than a starting point. It could happen on
	* real hardware with BG_TILE_WIDTH value (screen "shake" because of high
	* object redraw time + erratic behaviour from the player :))
	jbsr	force_all_screen_redraw
	
	rts
3:
	move.w	d0,previous_scroll_x
	* update unwrapped host scroll X
	* we need it to be continuous!
	move.w	host_scroll_x,d0
	add.w	d2,d0
	move.w	d0,host_scroll_x
	
	* now, are we still in min/max boundaries?
	cmp.w	min_scroll_x,d0
	jcc		0f
	* min overshoot: we have to do something on the left

	jbsr	draw_left_tiles
	sub.w	#BG_TILE_WIDTH,max_scroll_x
	sub.w	#BG_TILE_WIDTH,min_scroll_x
	
	jra		5f
0:

	add.w	#VISIBLE_SCROLL_WIDTH,d0
	cmp.w	max_scroll_x,d0
	jcs		5f
	* max overshoot: we have to do something on the right: draw the tiles

	jbsr	draw_right_tiles
	add.w	#BG_TILE_WIDTH,max_scroll_x
	add.w	#BG_TILE_WIDTH,min_scroll_x

5:

	rts

	
	
* < A0: filename
* < A1: buffer
* < D0: max size
load_file:
	move.l	_resload,d1
	jeq		0f
	move.l	d1,a2
	movem.l	d0-d3/a0/a1,-(a7)
	move.l	d0,d2		| store max size
	move.l	a0,d3		| store filename
	jbsr	resload_GetFileSizeDec(a2)
	.ifndef	RELEASE
	cmp.l	d0,d2
	jcc		0f
	BREAKPOINT	"file size too big vs buffer. D0=size, D2=max, D3=filename"
0:
	.endif
	movem.l	(a7)+,d0-d3/a0/a1
	
	jbsr	resload_LoadFileDecrunch(a2)
	rts
0:
	illegal
	
* < A6: memory base
install_bank_4:
	movem.l	a0/a1/d0,-(a7)
	lea	bank4_4000,a0
	lea		(bank_address_4000,a6),a1
	move.w	#0x7FF,d0
0:
	move.l	(a0)+,(a1)+
	dbf		d0,0b
	
	move.l	a6,bank_table+4*4	| first entry is RAM base
	move.l	a6,bank_base
	movem.l	(a7)+,a0/a1/d0
	
	rts

call_nmi:
	* reset most registers (not D5)
	jbsr	cpu_init
	* set base for RAM
	GET_MEMORY_START_AND_DP
	* should we set a saved copy of S or use the one that existed
	* when the game was interrupted? depends if the game was interrupted
	* in the original game code or in an osd function
	cmp.b	#1,osd_entry_count
	jeq		0f
	* osd_entry_count > 1: means that we interrupted an osd call
	* we have to restore d5 as it was on entering the osd call
	* restore game S (aka d5) so it's used in the irq
	* we must not change d5 until game irq has been called
	move.w	target_ssp_value,d5
0:

	swap	d5
	clr		d5
	swap 	d5
	.ifndef	RELEASE
	tst.w	d5
	jne		0f
	BREAKPOINT	"entering game irq with d5/S=0"
0:
	.endif
	
	jra	irq_65c4
	

* just in case some hardware calls nmi
_nmi:
	move.w	#0x7FFF,_custom+intreq
	move.w	#0x7FFF,_custom+intreq
	rts
	
level3_interrupt:
	movem.l d0-d7/a0-a6,-(a7)
	lea		_custom,a5
	move.w	(intreqr,a5),d0
	btst	#5,d0
	jeq		1f

	* music
	tst.b	_mt_E8Trigger
	jeq		0f
	cmp.b	#2,_mt_E8Trigger
	jeq		777f
	* trigger: map/level start music ended: time to start level music
	* if queued
	clr.b	_mt_E8Trigger
	clr.b	wait_for_map_music_end
	tst.b	play_level_1_tune_after_music_stop
	jeq		0f
	clr.b	play_level_1_tune_after_music_stop
	move.w	#LEVEL12_TUNE_SND,d0
	jbsr	osd_sound_start
	jra		0f
777:
	clr.b	_mt_E8Trigger
	* high score entry tune ended: load current level music
	* (don't play it)
	moveq	#0,d0
	move.b	(current_level_0072,a6),d0
	lea		current_level_music_table,a0
	add.w	d0,d0
	move.w 	(a0,d0.w),d0
	jbsr	load_music_if_needed
0:
	tst.b	detect_controllers
	jeq	0f
	clr.b	detect_controllers
	jsr	 _detect_controller_types_nowait

0:

	move.l	joypad_1_state(pc),d1
	move.l	d1,d2
	moveq	#0,d0
	move.b	p1_joystick_slot,d0
	jmi		0f
	jbsr	_read_joystick
	move.l	d0,joypad_1_state
0:

	jbsr	update_controls
	
	move.l	joypad_1_state,d0
	btst	#JPB_BTN_PLAY,d0
	beq.b	0f
	btst	#JPB_BTN_PLAY,d2
	bne.b	0f
	jbsr		toggle_pause
0:

	
	* ack vbl twice (040/pistorm bug)
	move.w	#0x20,(intreq,a5)
	move.w	#0x20,(intreq,a5)	
	jra	3f
1:
	.ifndef	RELEASE
	btst	#6,d0
	jne		2f
	BREAKPOINT	"unexpected level 3 interrupt"
2:
	.endif
	* has to be blitter operation completed: handle next blit
	* ack blitter int twice (040/pistorm bug)
	move.w	#0x40,(intreq,a5)
	move.w	#0x40,(intreq,a5)	

	
	PROCESS_ONE_BLIT

3:
    movem.l (a7)+,d0-d7/a0-a6
    rte


level1_interrupt:
 	.ifndef	RELEASE
	move.l	(2,a7),interrupted_code_pc
	.endif
	* disable osd context switch
	* we MUST NOT change d5 or change stack from an osd call from an interrupt
	addq.b	#1,osd_entry_count
    movem.l d0-d7/a0-a6,-(a7)
	lea		_custom,a5
	move.w	(intreqr,a5),d0		| leave this, we need it for later on
	* we're going to ack copper & software level 1 interrupt now
	* do it twice (040/pistorm bug)
	.rept	2
	move.w	#0x14,(intreq,a5)
	.endr

	tst.b	pause_flag
	jne	23f


	* declare that we're in interrupt mode so osd_disable_interrupts/osd_enable_interrupts
	* is level 1 interrupt set? that would mean that mid-screen interrupt
	* is the source of the interrupt
	btst	#4,d0
	beq.b	2f
	* mid-screen copper interrupt, must occur once every 5 times
	* to simulate ~60 Hz on 50 Hz display
	move.b	mid_screen_interrupt_count,d0
	addq.b	#1,d0
	cmp.b	#5,d0
	bne.b	1f
	jbsr	call_nmi
	clr.b	d0
1:
	move.b	d0,mid_screen_interrupt_count
	jra		3f	| no need to update sprites we're in the middle of a frame
2:


	jbsr	call_nmi
	
	
	GET_MEMORY_START_IN_A6
	move.w	(scroll_x_register_lsb_3b08,a6),d0
	ror.w	#8,d0		| hardware is in little endian
	move.w	D0,game_scroll_x
	move.w	(scroll_y_register_lsb_3b0a,a6),d0
	ror.w	#8,d0		| hardware is in little endian
	jpl		0f
	* scroll register is either 0 or negative FE00->FFFF->0000
	add.w	#0x200,d0
0:
	move.w	D0,game_scroll_y
	
	* ok now D5 can be used freely

	tst.b	frameskip
	jeq		0f
	eor.b	#1,flip_flop
	jeq		23f
0:
	* wait for blits to complete (via soft flag that last blitter command
	* sets when reaching the end of the list) and reset list pointers
	NEW_BLITLIST
	
	* In sync blitter, the ball is drawn, then buffers are switched
	* and current scroll makes up for ball moving in the opposite direction perfectly.
	*
	* In async blitter (OPT_BLIT_CHAIN_MODE==1), we use the scroll value stored in the blitter command list
	
	* show the newly drawn buffer THEN switch the buffers
	* problem: frames and scroll values aren't in sync, this is visible when
	* the ball crosses the screen, this is because we're now displaying what's been drawn
	* at the previous frame. 

	
	.if		OPT_BLIT_CHAIN_MODE==1
	jbsr	set_scroll_values
	jbsr	set_bobs_bitplanes
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	jbsr		switch_screen_buffers
	.endif

	lea		_custom,a5
	* start the chain reaction
	tst.b	size_command_issued
	jne		0f
	* size command not issued: set blitter scrolling immediately
	* no risks of bob shifting, there are no bobs on screen
	*move.l	scroll_x_hi,blitter_scroll_x
	*move.w	scroll_y,blitter_scroll_y
	jra		1f
0:
	.endif
	FORCE_PROCESS_BLITS
1:
	* fill the blitter command list while blitter interrupt 
	* is processing the other blitter command list
	* first fix the scrolling, so when it is set at the next frame, it is still coherent
	* with the shifting that we put on BOBs to follow it (original game doesn't need that
	* it has a separate layer for sprites, we just have crap dual playfield we cannot use here)

	*WRITE_BLITTER_SCROLL_VALUES		scroll_x_hi,scroll_y FUCK
	*jbsr		really_update_sprites
	* terminate the blitter command list
	COMMIT_BLITLIST

	.if		OPT_BLIT_CHAIN_MODE==0
	jbsr	set_scroll_values
	jbsr		really_update_sprites

	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	jbsr		switch_screen_buffers
	.endif
	jbsr	set_bobs_bitplanes
	.endif
	
	.ifndef	RELEASE
	tst.b	osd_debug_active
	jeq		0f
	.set	row,2
	GET_MEMORY_START_IN_A6
	WRITE_TEXT	scrollx_text,2
	WRITE_TEXT	scrolly_text,2
	WRITE_TEXT	hscrollx_text,2
	WRITE_TEXT	last_x_offset_text,2
	WRITE_TEXT	debug_1_text,4
	WRITE_TEXT	debug_2_text,4
	WRITE_TEXT	debug_3_text,4

	.set		row,2
	WRITE_HEX	game_scroll_x,3
	WRITE_HEX	game_scroll_y,3
	WRITE_HEX	host_scroll_x,3
	WRITE_HEX	x_offset,3
	lea		display_slots,a2
	tst.b	(a2)
	jeq		10f
	move.w	(2,a2),d0
	move.w	(a6,d0.w),d0
	WRITE_HEX	d0,3
	.set	row,row-1	
10:
	.set	row,row+1	
	addq	#4,a2
	tst.b	(a2)
	jeq		10f
	move.w	(2,a2),d0
	move.w	(a6,d0.w),d0
	WRITE_HEX	d0,3
	.set	row,row-1		
10:
	.set	row,row+1	
	addq	#4,a2
	tst.b	(a2)
	jeq		10f
	move.w	(2,a2),d0
	move.w	(a6,d0.w),d0
	WRITE_HEX	d0,3
	.set	row,row-1		
10:
	
	
0:
	.endif
	
	
	lea	_custom,a5
	move.w	(intreqr,a5),d0
	btst	#2,d0
	jeq		23f
	* interrupt arrived during this interrupt: this is taking too long
	* so skip the refresh
	move.b	#1,flip_flop
23:
	.ifne	OPT_ENABLE_LOGGING
	jbsr	log_used_fg_tiles
	jbsr	log_used_bg_tiles
	jbsr	log_used_sprites
	.endif
3:
    movem.l (a7)+,d0-d7/a0-a6
	* enable osd context switch
    subq.b	#1,osd_entry_count
 	.ifndef	RELEASE
	move.l	d0,-(a7)
	move.l	(6,a7),d0
	cmp.l	interrupted_code_pc,d0
	jeq		4f
	BREAKPOINT	"interrupt PC value changed!"
4:
	move.l	(a7)+,d0
	.endif
    rte
	
	
osd_blitz:
	blitz
	rts

osd_break:
	* sends a WinUAE command to enter WinUAE debugger
	.ifndef	RELEASE
* wait for VBL, so when breakpoint is hit, the DMA has displayed the current picture
	move.l	D0,-(a7)
	move.l	a0,-(a7)
	move.w	SR,-(a7)
	* block interrupts during the vblank wait
	* in dev mode, we use whdload in supervisor mode so SR can be written to
	move.w	#0x2700,SR
	lea	_custom,a0
	.rept	2
	move.w	#0x7FFF,intreq(a0)
0:
	move.w	intreqr(a0),d0
	btst	#5,d0
	beq.b	0b
	.endr
	move.w	(a7)+,sr
	move.l	(a7)+,a0

	pea     0.w
	* Normally it would point to where the result of the command is written, but since the last parameter (first pushed)
	* indicating the number of bytes to write is 0, nothing is written.
	pea     0.w	
	pea     1003f-1002f
	pea     1002f(pc)
	pea     -1.w
	pea     82.w
	jsr     0xf0ff60
	lea     24(sp),sp
	move.l	(a7)+,d0
	.endif
    rts
		
1002: .asciz    "AKS_ENTERDEBUGGER 1"
1003:
        .align	2

* < D0: number of 1/60Hz ticks
* can work with interrupts enabled or disabled
osd_wait:
	move.w	d0,delay_timer
	**jbsr	osd_is_vblank_interrupt_enabled
	tst.w	d0
	jne		2f
	* interrupts are disabled: timer isn't going to change
	* wait using vertical blank interrupt request (we don't need it!)
	clr.w	one_out_of_five
0:
	move.w	#0x20,_custom+intreq
	move.w	#0x20,_custom+intreq
1:
	move.w	_custom+intreqr,d0
	btst	#5,d0
	beq.b	1b
	addq.w	#1,one_out_of_five
	cmp.w	#5,one_out_of_five
	bne.b	5f
	subq.w	#1,delay_timer	
	clr.w	one_out_of_five
5:
	subq.w	#1,delay_timer
	beq.b	4f
	bpl.b	0b
4:
	rts
	
2:
	tst.w	delay_timer
	bne.b	2b
	rts

add_to_score:
	movem.l	a6/d0-d3,-(a7)
	GET_MEMORY_START_IN_A6
	moveq	#0,d0
	abcd 	d0,d0		| clear X
	move.b	(player_score_0068+2,a6),d0
	move.b	(player_score_0068+1,a6),d1
	move.b	(player_score_0068,a6),d2
	move.b	#0x90,d3		| 9000 points
	abcd	d3,d0
	jcc		0f
	moveq	#0,d3
	abcd	d3,d1
	jcc		0f
	abcd	d3,d2

0:
	move.b	d0,(player_score_0068+2,a6)
	move.b	d1,(player_score_0068+1,a6)
	move.b	d2,(player_score_0068,a6)
	movem.l	(a7)+,a6/d0-d3
	rts

lose_all_lives:
	movem.l	a6/d0-d3,-(a7)
	GET_MEMORY_START_IN_A6
	move.b	#1,(nb_lives_0060,a6)
	move.w	#1,(time_00aa,a6)
	movem.l	(a7)+,a6/d0-d3
	rts

* "0x00">Torch (crap)
* "0x01">Lance (okay)	
* "0x02">Axe (useless shit weapon)	
* "0x03">Shield (must have for last levels, but rather crap)
* "0x04">Sword (the best!)

cycle_weapon:
	movem.l	a6/d0,-(a7)
	GET_MEMORY_START_IN_A6
	move.b	(weapon_type_0073,a6),d0
	addq	#1,d0
	cmp.b	#5,d0
	jne		0f
	moveq	#0,d0
0:
	move.b	d0,(weapon_type_0073,a6)
	movem.l	(a7)+,a6/d0
	rts
	
* Z: set if playing
is_game_playing:
	movem.l	d0/a6,-(a7)
	GET_MEMORY_START_IN_A6
	* if game is in "continue play", consider that game is not playing
	* check that first
	move.w	(0x216A,a6),d0
	cmp.w	#0x434F,d0		| "CO"
	jeq		0f
	move.b	(global_state_0002,a6),d0
	cmp.b	#2,d0
1:
	movem.l	(a7)+,d0/a6
	rts
0:
	moveq	#1,d0
	jra		1b
	
* what: blits data on bg plane, no horizontal shifting (erase)
* args:
* < A0: pristine background
* < A1: dest buffer
* < D0: X (rounded to smaller 8-multiple)
* < D1: Y
* < D2: width in bytes
* < D4: height

* trashes: D0-D1

blit_background:
	movem.l	d2-d6/a0-a5,-(a7)
	lea		_custom,a5
	* adjust offset X: X//8
	lsr.w	#3,d0
	lea		mulBG_NB_BYTES_PER_ROW_table(pc),a4
	add.w	d1,d1
	* add Y offset: Y*NB_BYTES_PER_ROW
	add.w	(a4,d1.w),d0
	* same offset for source and destination
	add.w	d0,a1
	add.w	d0,a0

    move.l  #0x09f00000,d3    | A->D copy, ascending mode	
	move.w	#BG_NB_BYTES_PER_ROW,d1		| blit modulo

    sub.w   d2,d1       | blit modulo
    lsl.w   #6,d4
    lsr.w   #1,d2		| blit width
    add.w   d2,d4       | blit height
	
    * always the same settings

    * now just wait for blitter ready to write all registers
	WAIT_BLIT
    
    * blitter registers set

	WRITE_BLITTER_REG_LONG	d3,bltcon0	| sets con0 and con1

	WRITE_BLITTER_REG_WORD	d1,bltamod	|A modulo
	WRITE_BLITTER_REG_WORD	d1,bltdmod	|D modulo
							
	WRITE_BLITTER_REG_LONG	a0,bltapt	|source graphic top left corner
	WRITE_BLITTER_REG_LONG	a1,bltdpt	|destination top (bottom) left corner
	WRITE_BLITTER_REG_SIZE	d4	|rectangle size, starts blit
	
	* all bitplanes but not the last one that we'll clear
	
	.rept	NB_PLAYFIELD_PLANES-2
	.if	BG_SCREEN_PLANE_SIZE>0x7FFF
	add.l	#BG_SCREEN_PLANE_SIZE,a0
	add.l	#BG_SCREEN_PLANE_SIZE,a1
	.else
	add.w	#BG_SCREEN_PLANE_SIZE,a0
	add.w	#BG_SCREEN_PLANE_SIZE,a1
	.endif
	WAIT_BLIT
	* other bitplanes
	WRITE_BLITTER_REG_LONG	a0,bltapt	|source graphic top left corner
	WRITE_BLITTER_REG_LONG	a1,bltdpt	|destination top (bottom) left corner
	WRITE_BLITTER_REG_SIZE	d4	|rectangle size, starts blit
	.endr
	
	* last bitplane: just clear: just add to dest
	.if	BG_SCREEN_PLANE_SIZE>0x7FFF
	add.l	#BG_SCREEN_PLANE_SIZE,a1
	.else
	add.w	#BG_SCREEN_PLANE_SIZE,a1
	.endif
	
	* reuse d1 for bltcon0
	moveq	#1,d1
	ror.l	#8,d1     | AKA move.l  #0x01000000,d1   | minterm useD & rect clear (0xA) 

   * now just wait for blitter ready to write all registers
	WAIT_BLIT
    
	WRITE_BLITTER_REG_LONG	d1,bltcon0	
	WRITE_BLITTER_REG_LONG	a1,bltdpt	|destination top left corner
	WRITE_BLITTER_REG_SIZE	d4	|rectangle size, starts blit
	movem.l	(a7)+,d2-d6/a0-a5
	rts


*void gng_state::draw_sprites(bitmap_ind16 &bitmap, const rectangle &cliprect)
*{
*	uint8_t *buffered_spriteram = m_spriteram->buffer();
*	gfx_element *gfx = m_gfxdecode->gfx(2);
*
*	for (int offs = m_spriteram->bytes() - 4; offs >= 0; offs -= 4)
*	{
*		uint8_t attributes = buffered_spriteram[offs + 1];
*		int sx = buffered_spriteram[offs + 3] - 0x100 * (attributes & 0x01);
*		int sy = buffered_spriteram[offs + 2];
*		int flipx = attributes & 0x04;
*		int flipy = attributes & 0x08;
*
*		if (flip_screen())
*		{
*			sx = 240 - sx;
*			sy = 240 - sy;
*			flipx = !flipx;
*			flipy = !flipy;
*		}
*
*		gfx->transpen(bitmap,cliprect,
*				buffered_spriteram[offs] + ((attributes << 2) & 0x300),
*				(attributes >> 4) & 3,
*				flipx, flipy,
*				sx + 128, sy + 6, 15);
*	}
*}

really_update_sprites:

	***********************
	* erase previous BOBs *
	***********************
	
	move.l	bob_previous_drawed_sprites(pc),a4
	lea		_custom,a5


	* clear previous positions
	lea	background_restore_buffer,a0
	move.l	playfield_drawed_screen_ptr(pc),a1
	move.w	#NB_TARGET_SPRITES-1,d7
	WAIT_BLIT
	WRITE_BLITTER_REG_WORD	#-1,bltalwm		| needed for blit_background
1:
	move.w	(a4),d0
	bmi.b	11f		| x=0: inactive
	move.w	(2,a4),d1
	cmp.w	#BG_NB_LINES,d1
	jcc		11f				| too low: discard
	and.w	#0xFFF0,d0		| align on 16 lower bound
	* clear area where the sprite was
	move.l	#-1,(a4)+			| ack deletion by setting -1 in X & Y
	move.w	(a4)+,d4			| height
	move.w	(a4)+,d2		| width
				
	bsr		blit_background
	dbf		d7,1b	
	bra.b	12f
11:
	addq	#PREVIOUS_SPRITE_SIZE,a4
	dbf		d7,1b
12:	


	*********************
	* draw current BOBs *
	*********************
	
	GET_MEMORY_START_IN_A6
	lea		(SPRITE_ADDRESS+SPRITE_BUFFER_SIZE-CURRENT_SPRITE_SIZE,a6),a0
	*lea		mockup+SPRITE_BUFFER_SIZE-CURRENT_SPRITE_SIZE,a0


    lea _custom,A5
	move.l	bob_previous_drawed_sprites(pc),a6
	lea		shared_bob_table,a4
	
	moveq	#NB_TARGET_SPRITES-1,d7
1:
	jbsr	update_one_bob
	subq.w	#CURRENT_SPRITE_SIZE,a0
	dbf		d7,1b

	rts
	
*mockup:
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x0000
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x0010
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x0020
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xb3,0xa0,0x17,0xb8	|	0x0030
*.byte  0xab,0xa0,0x07,0xb8,0xa3,0xa0,0xf7,0xb8,0xb4,0xa0,0x17,0xc8,0xac,0xa0,0x07,0xc8	|	0x0040
*.byte  0xa4,0xa0,0xf7,0xc8,0xb5,0xa0,0x17,0xd8,0xad,0xa0,0x07,0xd8,0xa5,0xa0,0xf7,0xd8	|	0x0050
*.byte  0x3e,0x00,0x72,0x70,0x36,0x00,0x62,0x70,0x3f,0x00,0x72,0x80,0x37,0x00,0x62,0x80	|	0x0060
*.byte  0x11,0x00,0xf8,0x80,0x2f,0x00,0xf8,0x80,0x27,0x00,0xf8,0x80,0x27,0x00,0xf8,0x80	|	0x0070
*.byte  0x16,0x00,0xf8,0x70,0x1f,0x00,0xf8,0x80,0x17,0x00,0xf8,0x80,0x27,0x00,0xf8,0x80	|	0x0080
*.byte  0x10,0x04,0xf8,0x80,0x11,0x00,0xf8,0x80,0x11,0x00,0xf8,0x80,0x13,0x00,0xf8,0x80	|	0x0090
*.byte  0x18,0x00,0xf8,0x70,0x10,0x00,0xf8,0x70,0x19,0x00,0xf8,0x80,0x11,0x00,0xf8,0x80	|	0x00a0
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x00b0
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x00c0
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x00d0
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x00e0
*.byte  0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8,0xf8	|	0x00f0

compute_sprite_xy_code:
	moveq	#0,d0
	* attributes = buffered_spriteram[offs + 1]
	* sx = buffered_spriteram[offs + 3] - 0x100 * (attributes & 0x01)

	move.b	(TARGET_SPRITE_X,a0),d0
	moveq	#0,d1
	move.b	(TARGET_SPRITE_Y,a0),d1


	.ifne	SPRITE_Y_CORRECTION
	add.w	#SPRITE_Y_CORRECTION,d1
	.endif
	.ifne	SPRITE_X_CORRECTION
	add.w	#SPRITE_X_CORRECTION,d0
	.endif
	
	* tile_code = buffered_spriteram[offs] + ((attributes << 2) & 0x300)
	moveq	#0,d2
	move.b	(TARGET_SPRITE_ATTRIBUTES,a0),d2
	btst	#0,d2
	jeq		0f
	sub.w	#0x100,d0
0:
	and.b	#0xC0,d2
	lsl.w	#2,d2
	move.b	(TARGET_SPRITE_CODE,a0),d2
	
	rts
	
update_one_bob:

	move.l	A0,-(a7)
	* Y/X = 0xF8 (raw): nothing displayed
	move.w	(a0),d3
	cmp.w	#0xF8F8,d3
	jeq		2f
0:
	jbsr	compute_sprite_xy_code
	tst.w	d1
	jmi		0f			| (slightly) negative: accept/clip it
	cmp.w	#240,d1		| too low: scrap it
	jcc		2f
	tst.w	d0
	* if X < -32 don't display it (-16 doesn't seem enough)
	jpl		0f
	cmp.w	#-32,d0
	jcs 	2f
0:
	* handle custom amiga horizontal grouping (saves a lot of blitter masking)
	* the table holds several info bits
	* - if 0, this is a normal sprite, no horizontal grouping
	* - if >0, this is a grouped sprite, it also has bit 0 set (to differentiate
	* as sprite 0 is grouped) and is encoded on 1..15 bits (*2)
	*   it repeats the sprite number in the table, only display if not mirrored
	* - if >0 but bit 14 set, never draw
	* - if <0, this is the other half part of the sprite, only display if mirrored
	* it also has bit 0 set
	* that's why we negate the value if mirror (saves a lot of combinations) and test if positive in all cases
	*
	* so for instance, boss sprite 0x2C0 is grouped with 0x2C1, 0x2C2, 0x2C3 (boss has 4 tiles)
	* at offset 0x2C0*2 the table contains the following 16-bit words
	* .word   0x0581,0x4000,0x4000,0xfa81
	* 0x581 divided by 2 = 0x2C0 and 0xfa81 without bit 0 divided by 2 = 0x2C0 as well
	*
	* only sprite 0x2C0 is registered in the base, and is displayed mirrored when game
	* tries to display sprite 0x2C3 mirrored
	* 
	*
	move.b	(TARGET_SPRITE_ATTRIBUTES,a0),d3
	
	.if		OPT_MIRROR_TEST==1
	bset	#MIRROR_BIT,d3
	move.b	d3,(TARGET_SPRITE_ATTRIBUTES,a0)
	.endif
	
	lea		sprite_group_table(pc),a3
	add.w	d2,d2				| code times 2
	move.w	(a3,d2.w),d4
	jeq		10f			| nothing to do, normal tile
	* double/triple/quadruple, whatever
	btst	#14,d4
	jne		2f		| bit 14 set: center tile, never draw
	bclr	#0,d4	| remove bit 0 now
	asr.w	#1,d4	| divide by 2, signed
	btst	#MIRROR_BIT,d3
	jeq		101f
	* mirror: "negate" the code by flipping bit 10
	bchg	#10,d4
101:
	btst	#10,d4
	jne		2f		| no need to draw this part, the other part will do it
	move.w	d4,d2	| get the real sprite code to draw
	add.w	d2,d2	| code times 2
10:
	add.w	d2,d2				| code times 4 now

	move.l	(a4,d2.w),d4		| get pointer from shared bob table
	jne		200f
	* not in the shared bob table. Is it in the level specific bob table?
	move.l	context_sprite_table_ptr,a3
	move.l	(a3,d2.w),d4		| get pointer from specific bob table	
	.ifdef	RELEASE
	jeq		2f				| can theorically happen as sprite update is not atomic (it could be...)
	.else
	jne		100f
	* in dev mode, break if we try to display a non-existing bob

	moveq	#0,d2
	move.b	(TARGET_SPRITE_ATTRIBUTES,a0),d2
	and.b	#0XC0,d2
	lsl.w	#2,d2
	move.b	(TARGET_SPRITE_CODE,a0),d2
	move.b	(TARGET_SPRITE_ATTRIBUTES,a0),d3
	COLOR0_FLASH	0xF00
	*BREAKPOINT	"unregistered sprite clut (D2=code, D3=attribute)"
	jra		2f
100:
	.endif
200:
	* now select proper clut
	move.l	d4,a0
	moveq	#0,d2
	move.b	d3,d2
	lsr.b	#4,d2
	and.b	#0x3,d2
	.ifdef MC68020
	move.l	(a0,d2.w*4),d4
	.else
	add.w	d2,d2
	add.w	d2,d2
	move.l	(a0,d2.w),d4
	.endif
	jeq		2f		| invalid clut: can happen in transition phases
	move.l	d4,a0

	move.w	(a0)+,d4		| height
	move.w	(a0)+,d5		| width
	add.w	(a0)+,d1		| add offset to Y
	* A0 points on the first bitplane of the bob
	addq 	#2,a0

* now we have to check if mirror must be performed, either by doing this in-place
* or by selecting already mirrored data
	lea		((NB_PLAYFIELD_PLANES+1)*4,a0),a1		| load mirrored data pointers
	tst.w	(a1)
	jmi		101f		| invalid pointers: we must do in-place
	btst	#MIRROR_BIT,d3
	jeq		102f
	* to mirror, just change pointer list
	move.l	a1,a0
	* and skip mirroring bit
	jra		103f
101:
	btst	#MIRROR_BIT,d3
102:
	sne		d3		| convert attribute to boolean 0/ff for mirror_sprite_planes
	jbsr	mirror_sprite_planes
103:	
	* BOBs must follow screen scroll
	add.w	bobs_game_scroll_y,d1
	add.w 	bobs_host_scroll_x,d0
	
	* D0 and D1 are already set
	move.l	(NB_PLAYFIELD_PLANES*4,a0),d2
	beq.b	2f		| mask is zero: blank tile => skip
	
	move.l		playfield_drawed_screen_ptr(pc),a1
	
	move.l	d2,a3
	* now 2 cases: if Y is negative, we have to clip, else normal
	tst		d1
	jpl		8f
	* negative: can happen specially on vertical levels
	* convert that to clip
	add.w	d1,d4		| reduce height
	jeq		2f
	jmi		2f			| too high => skip
	neg		d1			| make it positive again
	* now multiply d1 by number of bytes per bob source row
	* we only have 2 cases here: 4 and 6 (technically big boss 
	* could qualify but it doesn't happen)
	add.w	d1,d1		| times 2
	cmp.w	#6,d5
	jne		7f
	add.w	d1,d1		| times 4 (double width)
7:
	move.w	d5,d2			| width in bytes, 4 for 16 pixels+shift
	move.w	d1,d5		| set Y offset
	moveq	#0,d1		| and coord = 0

	
	* store attributes for clipped sprite erase (unless blocked)
	move.w	d0,(a6)+			| store current sprite attributes to previous ones
	clr.w	(a6)+			    | store current sprite attributes to previous ones
	move.w	d4,(a6)+			| store height
	move.w	d2,(a6)+			| store width in bytes

	jra		9f

8:
	cmp.w	#BG_NB_LINES,d1
	jcc		2f		| avoid out of screen

	* note down that this bob will have to be erased
	* store attributes for non-clipped sprite erase



	* store attributes for clipped sprite erase (unless blocked)
	move.w	d0,(a6)+			| store current sprite attributes to previous ones
	move.w	d1,(a6)+			| store current sprite attributes to previous ones
	move.w	d4,(a6)+			| store height
	move.w	d5,(a6)+			| store width in bytes

	move.w	d5,d2			| width in bytes, 4 for 16 pixels+shift
	moveq	#0,d5			| Y-offset

9:
	moveq	#NB_PLAYFIELD_PLANES,d3

	jbsr	blit_planes_any_internal_cookie_cut
2:
	move.l	(a7)+,a0
	rts


* < A0: plane list
* < D3: required orientation
* < D4: height
* < D5: width (bytes) including 16 bit shift
* trashes: only unused registers :) D6,A3

mirror_sprite_planes:
	movem.l	d0-d2/a0,-(a7)
	* bitplanes aren't pre-computed: check bitplanes current orientation and swap
	* if required. This is slow but saves memory
	.if		OPT_BLIT_CHAIN_MODE==0
	lea		mirror_table,a1
	.endif
	moveq	#NB_PLAYFIELD_PLANES+1-1,d6
	lea		mirror_function_table(pc),a3
	.ifndef	MC68020
	move.w	d5,d0       | number of byte values (ex: 4: 16 bits + shifting)
	add.w	d0,d0
	move.l	(a3,d0.w),a3
	.else
	move.l	(a3,d5.w*2),a3		| compute mirror function once and for all
	.endif
0:
	move.l	(a0)+,d1		| current plane data
	jeq		1f				| no data: skip
	move.l	d1,a2
	cmp.b	(-2,a2),d3		| 2 bytes before: mirror flag
	jeq		1f
	* not the proper orientation: change it
	move.b	d3,(-2,a2)
	* perform or queue the mirroring
	WRITE_BLITTER_VIRTUAL_MIRROR	d4,a3,a2

	* next bitplane
1:
	dbf		d6,0b
	movem.l	(a7)+,d0-d2/a0
	rts
	

* < A1: mirror table
* < A2: bitmap
* < D1+1: height
* destroys d0-d2, a2

mirror_16_bit_wide:
	.ifdef	MC68020
	moveq	#0,d2
	.endif
10:
	.ifndef	MC68020
	* we have to do that each time as we must add offsets as long (table is 128k long)
	moveq	#0,d2
	.endif
	move.w	(a2)+,d2
	jeq		14f					| zero: optim
	.ifndef	MC68020
	add.l	d2,d2
	move.w	(a1,d2.l),(-2,a2)   | use .l as d2.w may be > 0x7FFF
	.else
	move.w	(a1,d2.l*2),(-2,a2)
	.endif
14:
	dbf		d1,10b		| next
	rts

mirror_32_bit_wide:
	.ifdef	MC68020
	moveq	#0,d0
	.endif
10:
	.ifndef	MC68020
	* we have to do that each time as we must add offsets as long (table is 128k long)
	moveq	#0,d0
	.endif
	move.l	(a2)+,d2
	jeq		14f		| if line is blank, no need to mirror
	move.w	d2,d0
	clr.w	d2
	swap	d2
	.ifndef	MC68020
	add.l	d2,d2
	add.l	d0,d0
	move.w	(a1,d2.l),-(a2)		| get mirror value
	move.w	(a1,d0.l),-(a2)		| get mirror value
	.else
	move.w	(a1,d2.l*2),-(a2)		| get mirror value
	move.w	(a1,d0.l*2),-(a2)		| get mirror value
	.endif
	addq	#4,a2					| skip row
14:
	dbf		d1,10b
	rts


mirror_48_bit_wide:
	.ifdef	MC68020
	moveq	#0,d0
	moveq	#0,d2
	.endif
10:
	.ifndef	MC68020
	* we have to do that each time as we must add offsets as long (table is 128k long)
	moveq	#0,d0
	moveq	#0,d2
	.endif
	move.w	(a2),d2
	move.w	(4,a2),d0
	* edges
	.ifndef	MC68020
	add.l	d2,d2
	add.l	d0,d0
	move.w	(a1,d2.l),(4,a2)		| get mirror value
	move.w	(a1,d0.l),(a2)+		| get mirror value
	.else
	move.w	(a1,d2.l*2),(4,a2)		| get mirror value
	move.w	(a1,d0.l*2),(a2)+		| get mirror value
	.endif
	* center
	.ifndef	MC68020
	* we have to do that each time as we must add offsets as long (table is 128k long)
	moveq	#0,d2
	.endif
	move.w	(a2),d2
	.ifndef	MC68020
	add.l	d2,d2
	move.w	(a1,d2.l),(a2)
	.else
	move.w	(a1,d2.l*2),(a2)
	.endif
	addq	#4,a2					| skip row
	dbf		d1,10b
	rts


mirror_64_bit_wide:
	.ifdef	MC68020
	moveq	#0,d0
	moveq	#0,d2
	.endif
10:
	.ifndef	MC68020
	moveq	#0,d0
	moveq	#0,d2
	.endif
	
	move.w	(a2),d2
	move.w	(6,a2),d0
	* swap edges
	.ifndef	MC68020
	add.l	d2,d2
	add.l	d0,d0
	move.w	(a1,d2.l),(6,a2)		| get mirror value
	move.w	(a1,d0.l),(a2)+		| get mirror value
	* swap center words
	moveq	#0,d0
	moveq	#0,d2
	move.w	(a2)+,d2
	move.w	(a2),d0
	add.l	d2,d2
	add.l	d0,d0
	move.w	(a1,d2.l),(a2)
	move.w	(a1,d0.l),-(a2)
	.else
	* 68020+ is handy here as scaling doesn't corrupt MSW
	move.w	(a1,d2.l*2),(6,a2)		| get mirror value
	move.w	(a1,d0.l*2),(a2)+		| get mirror value
	* swap center words
	move.w	(a2)+,d2
	move.w	(a2),d0
	move.w	(a1,d2.l*2),(a2)
	move.w	(a1,d0.l*2),-(a2)
	.endif
	addq	#6,a2					| skip row
	dbf		d1,10b
	rts

	
mirror_function_table:
	.long	nope
	.long	nope
	.long	mirror_16_bit_wide
	.long	mirror_32_bit_wide
	.long	mirror_48_bit_wide
	.long	mirror_64_bit_wide
	.long	nope		| just in case, but there are no such objects
	.long	nope

nope:
	rts
	
	
* < D0,D1: x,y
* < A1: foreground plane pointer (often first plane!)
* < D2: width in bytes (inc. 2 extra for shifting)
* < D3: nb planes to clear
* < D4: blit height


* trashes D0-D6/A2
clear_planes_any_blitter_internal:
    * pre-compute the maximum of shit here
	move.w	d1,d6
    beq.b   1f    | optim
	* check if y start + height > Y_MAX
	* (ignores case where y = 0, no risk)
	add.w	d4,d6
	sub.w	#Y_MAX,d6
	bmi.b	0f
	* y start + height > Y_MAX: clip height
	sub.w	d6,d4
	beq.b	10f
	bpl.b	0f
10:
	* null or negative height after clipping: out
	rts
0:
    lea mulBG_NB_BYTES_PER_ROW_table(pc),a2
    add.w   d1,d1
    move.w  (a2,d1.w),d1
1:
    and.w   #0x1F0,d0
    beq.b   2f				| zero X optimization
    lsr.w   #3,d0
    add.w   d0,d1
2:   
    add.w   d1,a1       | plane position (always even)

	* reuse d1 for bltcon0
	moveq	#1,d1
	ror.l	#8,d1     | AKA move.l  #0x01000000,d1   | minterm useD & rect clear (0xA) 

	move.w #BG_NB_BYTES_PER_ROW,d0
	bclr	#0,d2		| make sure D2 is even (else strange things occur!)
    sub.w   d2,d0       | blit width

	move.w	d4,d6		| save height
    lsl.w   #6,d4
    lsr.w   #1,d2
    add.w   d2,d4       | blit height+width
	moveq	#-1,d2
    * now just wait for blitter ready to write all registers
	WAIT_BLIT
    
	WRITE_BLITTER_REG_LONG	d2,bltafwm
	WRITE_BLITTER_REG_LONG	d1,bltcon0	
	WRITE_BLITTER_REG_WORD	d0,bltdmod	|D modulo
	
	subq	#1,d3
	jeq		4f
3:
	WAIT_BLIT
	WRITE_BLITTER_REG_LONG	a1,bltdpt	|destination top left corner
	WRITE_BLITTER_REG_SIZE	d4	|rectangle size, starts blit
32:
	.if	BG_SCREEN_PLANE_SIZE>0x7FFF
	add.l	#BG_SCREEN_PLANE_SIZE,a1
	.else
	add.w	#BG_SCREEN_PLANE_SIZE,a1
	.endif
	dbf		d3,3b
4:
	rts
	
	
	
* < A5: custom
* < D0.W,D1.W: x,y
* < A0: source (pointer on array of planes)
* < A1: destination fg plane, also background to mix with cookie cut fg plane
* < A3: source mask for cookie cut
* < D2: width in bytes (inc. 2 extra for shifting)
* < D3: number of planes
* < D4: height. If negative, source is copied with negative modulo (flip)
* < D5: y offset for source planes
* < D7: blit mask (not considered, optim, -1 all through the game)
* blit mask set
* returns: start of destination in A1 (computed from old A1+X,Y)
* trashes: a1
blit_planes_any_internal_cookie_cut:
    movem.l d0-d7/a4,-(a7)
    * pre-compute the maximum of shit here
	tst.w	d4
	bpl.b	1f
	sub.w	d4,d1	| pre-add height to d1
	subq.w	#1,d1	| minus one
1:	
	tst	d1
    beq.b   5f    | optim
	
4:	
    lea		mulBG_NB_BYTES_PER_ROW_table(pc),a4
	.ifndef	MC68020
	add.w	d1,d1
    move.w  (a4,d1.w),d1	| y times 40
	.else
    move.w  (a4,d1.w*2),d1	| y times 40
	.endif
5:
	lea		cookie_cut_blit_table(pc),a4
	
    move.w  d0,d6
    lsr.w   #3,d0			| X displacement in bytes
	*bclr	#0,d0			| no need, it will be even
    and.w   #0xF,d6
	.ifndef	MC68020
	add.w	d6,d6
	add.w	d6,d6
	move.l	(a4,d6.w),d7
	lea		cookie_cut_mask_blit_table(pc),a4
	move.l	(a4,d6.w),d6
	.else
	move.l	(a4,d6.w*4),d7
	lea		cookie_cut_mask_blit_table(pc),a4
	move.l	(a4,d6.w*4),d6
	.endif
3:   
    add.w   d0,d1
4:
    * make offset even. Blitter will ignore odd address
    * but a 68000 CPU doesn't and since we RETURN A1...
    *bclr    #0,d1
    add.w   d1,a1       | plane position (D1 < 0x7FFF, 288*40=0x2D00)
	move.w	#BG_NB_BYTES_PER_ROW,d0
	tst.w	d4
	bpl.b	5f
	neg.w	d0
	neg.w	d4    | make d4 positive again
5:
    sub.w   d2,d0       | blit width
    lsl.w   #6,d4
    lsr.w   #1,d2
    add.w   d2,d4       | blit height
    * always the same settings (ATM)
	moveq	#-2,d2
	add.w	d5,a3			| apply y offset to mask too (y offset looks wrong)
	
    * now just wait for blitter ready to write all registers
	WAIT_BLIT
    
    * blitter registers set

	WRITE_BLITTER_REG_WORD	d2,bltamod		|A modulo=bytes to skip between lines
	WRITE_BLITTER_REG_WORD	d2,bltbmod		|B modulo=bytes to skip between lines
	moveq	#0,d2
	WRITE_BLITTER_REG_WORD	d2,bltalwm	    | so the -2 modulo trick works
	
	WRITE_BLITTER_REG_WORD	d0,bltcmod	|C modulo
	WRITE_BLITTER_REG_WORD	d0,bltdmod	|D modulo
					
	subq	#1,d3
	jeq	7f
	subq	#1,d3
6:
	WRITE_BLITTER_REG_LONG	a3,bltapt	|source graphic top left corner (mask)
	jbsr	start_process_1_plane
	
	WRITE_BLITTER_REG_LONG	a1,bltcpt	|pristine background top (bottom) left corner
	WRITE_BLITTER_REG_LONG	a1,bltdpt	|destination top (bottom) left corner
	WRITE_BLITTER_REG_SIZE	d4	|rectangle size, starts blit
	.if	BG_SCREEN_PLANE_SIZE > 0x7FFF
	add.l	#BG_SCREEN_PLANE_SIZE,a1
	.else
	add.w	#BG_SCREEN_PLANE_SIZE,a1
	.endif
	WAIT_BLIT
	dbf		d3,6b
7:
	WRITE_BLITTER_REG_LONG	a3,bltapt	|source graphic top left corner (mask)
	jbsr	start_process_1_plane
	WRITE_BLITTER_REG_LONG	a1,bltcpt	|pristine background top (bottom) left corner
	WRITE_BLITTER_REG_LONG	a1,bltdpt	|destination top (bottom) left corner
	WRITE_BLITTER_REG_SIZE	d4	|rectangle size, starts blit
10:
    movem.l (a7)+,d0-d7/a4
    rts
	
start_process_1_plane:
	move.l (a0)+,d0
	beq.b	60f
	move.l	d0,a4
	add.w	d5,a4		| add Y offset
	jra		61f
60:
	* source is 0: just apply mask (less bandwidth lost) and change bltcon
	WRITE_BLITTER_REG_LONG	d6,bltcon0	| sets con0 and con1: C-A->D cookie cut, B fixed
	WRITE_BLITTER_REG_WORD	d2,bltbdat	|B word is zero
	rts
61:
	* non-zero: set data source & bltcon
	WRITE_BLITTER_REG_LONG	d7,bltcon0	| sets con0 and con1: C-A+B->D cookie cut full
	WRITE_BLITTER_REG_LONG	a4,bltbpt	|source graphic top left corner
	rts

	.macro	GEN_MINTERM_TABLE	name,value
\name\()_table:
	.set	shift,0
	.rept	16
	.long	(shift<<28)+(shift<<12)+(\value<<16)
	.set	shift,shift+1
	.endr
	.endm
	
	.macro	GEN_MINTERM_TABLE_2	name,value
\name\()_table:
	.set	shift,0
	.rept	16
	.long	(shift<<28)+(\value<<16)
	.set	shift,shift+1
	.endr
	.endm
	
	GEN_MINTERM_TABLE	cookie_cut_blit,0x0FCA
	GEN_MINTERM_TABLE_2	cookie_cut_mask_blit,0x0BCA



bank_base:
	.long	0
bank_table:
	.long	bank0_4000-0x4000
	.long	bank1_4000-0x4000
	.long	bank2_4000-0x4000
	.long	bank3_4000-0x4000
	.long	0  | bank4_4000-0x4000
	
bob_previous_positions_1:
	.fill NB_TARGET_SPRITES*PREVIOUS_SPRITE_SIZE , 1 , -1
	
bob_previous_drawed_sprites:
	.long	bob_previous_positions_1
bob_previous_displayed_sprites:
	.ifeq	OPT_ENABLE_DOUBLE_BUFFERING
	.long	bob_previous_positions_1
	.else
	.long	bob_previous_positions_2	
bob_previous_positions_2:
	.fill NB_TARGET_SPRITES*PREVIOUS_SPRITE_SIZE , 1 , -1

	.endif

	
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
switch_screen_buffers:

	* let's switch screen buffers, background (chars)
	* toggle fg planes (double buffering)
	* also toggle previous sprite positions
	lea		playfield_drawed_screen_ptr(pc),a0
	lea		bob_previous_positions_1(pc),a2
	lea		bob_previous_positions_2(pc),a3
	move.l	playfield_screen_data_1,a1
	move.l	playfield_screen_data_2,a5
	* also switch previous state memory
	cmp.l	(a0),a1
	bne.b	2f
	* screen data 1 is displayed screen
	* set it to drawn screen
	exg		a1,a5
	exg		a2,a3
2:
	move.l	a1,(a0)
	move.l	a5,playfield_displayed_screen_ptr
	move.l	a3,bob_previous_displayed_sprites
	move.l	a2,bob_previous_drawed_sprites

	jbra		set_bobs_bitplanes
	.endif
	
	
store_system:
	tst.l	_resload
	beq.b	0f
	rts
0:
	* system copper
	
	move.l	4.W,a6
	move.w	AttnFlags(a6),d0
	btst	#AFB_68010,d0
	beq.b	1f
	lea	get_vbr,a5

	jsr		_LVOSupervisor(a6)
	move.l	d0,system_vbr
1:
	

	lea	_custom,a6
	move.w	intenar(a6),old_intena
	move.w	dmaconr(a6),old_dmacon
	lea		old_sysvectors,a0
	move.l	system_vbr(pc),a1
	move.l	(0x64,a1),(a0)+
	move.l	(0x68,a1),(a0)+
	move.l	(0x6c,a1),(a0)+
	move.l	(0x70,a1),(a0)+
	move.l	(0x74,a1),(a0)+
	move.l	(0x78,a1),(a0)+
	move.l	(0x7C,a1),(a0)+
	rts

restore_system:
	move.l	system_vbr(pc),a0
	lea	_custom,a6
	jsr		_mt_remove_cia

	move.w	#0x4000,intena(a6)	| ints off
	lea		old_sysvectors,a0
	move.l	system_vbr(pc),a1
	move.l	(a0)+,(0x64,a1)
	move.l	(a0)+,(0x68,a1)
	move.l	(a0)+,(0x6c,a1)
	move.l	(a0)+,(0x70,a1)
	move.l	(a0)+,(0x74,a1)
	move.l	(a0)+,(0x78,a1)
	move.l	(a0)+,(0x7C,a1)


	bclr	#6,0xbfee01


	lea	_custom,a6
	move.w	old_intena,d0			| get old val
	and.w	#0x3fff,d0
	eor.w	#0x3fff,d0
	move.w	d0,intena(a6)		| clr bits
	eor.w	#0x3fff,d0
	or.w	#0xc000,d0		
	move.w	d0,intena(a6)		| set bits and main

	move.w	old_dmacon,d0			| get old val
	and.w	#0x3fff,d0
	eor.w	#0x3fff,d0

***		and.w	#0xfff0,d0		| preserve sound dma for now

	move.w	d0,dmacon(a6)		| clr bits



	eor.w	#0x3fff,d0
	or.w	#0xc000,d0		
	move.w	d0,dmacon(a6)		| set bits and main

	move.l	old_syscoplist,cop1lc(a6)
	move.l	_gfxbase,a6
	move.b	gb_ChipRevBits0(a6),chiprevbits+3
	move.l	old_actiview,a1
	jsr	_LVOLoadView(a6)


	moveq	#0,d0
	rts


	
platform_init:
	bsr		store_system
	

	lea		_custom,a5
	move.w	#0x7FFF,dmacon(a5)
	move.w	#0x7FFF,intena(a5)
	* set blitter parameters
	move.l	#-1,bltafwm(a5)
	
	move.l	monitor,d0
	cmp.l	#NTSC_MONITOR_ID,D0
	bne		0f
	st.b	ntsc_flag
	* disable extra mid-screen interrupt, as it would be too fast (NTSC)
	move.w	#COPPER_NOP,pal_intreq_block_game
	* also change screen start position, make it higher
	move.w	#0x01+(0xC<<8),screen_start
	sub.b	#8,weapon_palette_wait_value
	
	*move.w	#0x0401,pal_wait			| else intreq never happens
0:
	.if		NB_PLAYFIELD_PLANES==8
    move.w #0x0210+BORDERBLANK,bplcon0(a5) | 8 bitplanes, borderblank
	.else
    move.w #0x200+BORDERBLANK+(NB_PLAYFIELD_PLANES<<12),bplcon0(a5) | 8 > nb bitplanes, borderblank
	.endif
    move.w #BASE_BPLCON2_VALUE,bplcon2(a5)


 	*         VVHH
    move.w #0x89+((Y_START+0x10)<<8),d0
    move.w #0x89+((Y_START-0x10)<<8),d1
	cmp.l	#NTSC_MONITOR_ID,monitor
	jne		0f
	sub.w	#NTSC_Y_SHIFT<<8,d0
	sub.w	#NTSC_Y_SHIFT<<8,d1
0:	
	* AGA

	.ifne	OPT_AGA_MODE
    move.w #BASE_BPLCON4_VALUE,bplcon4(a5)
    move.w #0x0C00+BORDERBLANK<<5,bplcon3(a5)     | no AGA specificities, default ECS
    add	#AGA_X_SHIFT,d0
    add	#AGA_X_SHIFT,d1
	.endif
	
    move.w d0,diwstrt(a5)
    move.w d1,diwstop(a5)
    move.w #0x0038,ddfstrt(a5)

	move	#BG_NB_BYTES_PER_ROW-40,d0

	.ifne	OPT_AGA_MODE
    move.w #0x00C0,ddfstop(a5)		| C0 for fmode=3
	move.w	#(3<<2)+3,fmode(a5)		| wide sprites, faster fetch
	subq	#8,d0			| change modulo
 	.else
	move.w #0x00D0,ddfstop(a5)		| C0 for fmode=3
	.endif
	
	* 0 modulo (OCS)
    move.w d0,bpl1mod(a5)
    move.w d0,bpl2mod(a5)

	.ifdef	NEED_ROWS
	lea		rows_table,a1
	* generate a contiguous pointer table for copperlist row entries
	* we cannot have a contiguous copperlist because we need to insert
	* stuff now and then (ntsc emulation, color change, PAL wait)
	lea		first_rows,a0
	move.w	#NB_FIRST_ROWS,d0
	jbsr	generate_row_table
	lea		second_rows,a0
	move.w	#NB_SECOND_ROWS,d0
	jbsr	generate_row_table
	lea		third_rows,a0
	move.w	#NB_THIRD_ROWS,d0
	jbsr	generate_row_table
	lea		fourth_rows,a0
	move.w	#NB_FOURTH_ROWS,d0
	jbsr	generate_row_table
	.endif
	
	* install jump for palette switch
	move.l	#after_osd_lower_palette,d0
	lea		osd_lower_palette_switch_address,a0
	move.w	d0,(6,a0)
	swap	d0
	move.w	d0,(2,a0)
	
	lea		hw_sprite_ram_buffer,a0
	jbsr	align_for_fmode
	moveq	#7,d0
	lea		hw_sprite_pointers,a1
0:
	move.l	a0,(a1)+
	add.w	#HW_SPRITE_BUFFER_SIZE,a0
	dbf		d0,0b
	
	lea		bobs_screen_buffer_1,a0
	addq	#2,a0	| leave 16 bits hidden for left side clipping
	jbsr	align_for_fmode
	move.l	a0,playfield_screen_data_1
	move.l	a0,playfield_drawed_screen_ptr
	move.l	a0,playfield_displayed_screen_ptr
	
	st		music_track_start_number

	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	lea		bobs_screen_buffer_2,a0
	addq	#2,a0	| leave 16 bits hidden for left side clipping
	jbsr	align_for_fmode
	move.l	a0,playfield_screen_data_2
	move.l	a0,playfield_displayed_screen_ptr
	.endif
		
	* init color table handling the bank switch issue
	lea		copperlist_colors,a0
	lea		color_copper_pointers,a1
	moveq	#(TOTAL_NB_COLORS/32),d0		| nb banks for all colors + sprite color bank
0:
	.ifne	OPT_AGA_MODE
	addq.w	#4,a0		| skip set bank
	.endif
	move.w	#31,d1		| 32 colors per bank
1:
	move.l	a0,(a1)+
	addq.w	#4,a0
	dbf		d1,1b
	dbf		d0,0b
	
	
	
	* put static sprite entries, we'll write into
	* that sprite area
	lea		game_sprites,a2
	lea		hw_sprite_pointers,a1
1:
	move.l	(a1)+,d0
	move.w	d0,(6,a2)
	swap	d0
	move.w	d0,(2,a2)
	*swap	d0
	addq	#8,a2
	cmp.l	#game_sprites_end,a2
	bcs		1b
2:
	* compute control words for each sprite pair
	lea		hw_sprite_pointers,a0
	lea		HW_SpriteYTable_256,a1
	moveq	#3,d7
	moveq	#0x3F,d2	| sprite X start
0:
	move.w	d2,d0
	move.w	#0x14,d1
	tst.b	ntsc_flag
	jeq		1f
	sub.w	#12,d1		| sprites slightly higher
1:
	jbsr	store_sprite_pos
	add.w	#64,d2		| advance X
	
	* store control word
	.rept	2
	move.l	(a0)+,a2
	move.w	d0,(8,a2)
	swap 	d0
	move.w	d0,(a2)
	swap	d0
	bset	#7,d0		| attach bit
	addq	#8,a2
	.endr
	
	dbf	d7,0b

	
	* load attached sprites palette
	lea		fg_tile_upper_palette,a0
	move.l	color_copper_pointers+TOTAL_NB_COLORS*4,a1	| entries 64-80
	move.w	#16,d0
	jbsr	load_palette
		
	* load palette for bottom tiles (in-game), skipping first color (transparent, for sprites)
	lea		fg_tile_lower_palette+2,a0
	lea		osd_lower_palette,a1
	move.w	#15,d0
	jbsr	load_palette
	
	lea		sprite_palette,a0
	move.l	color_copper_pointers+TOTAL_NB_COLORS/2*4,a1	| entries 32-64
	move.w	#TOTAL_NB_COLORS/2,d0
	jbsr	load_palette
	
	
	jbsr		set_bobs_bitplanes
	
	
	lea		_custom,a5
	lea		game_copperlist,a0
	move.l	a0,cop1lc(a5)

	

	* wait 300 lines
	move.w	#100,d0
	bsr	beamdelay
	move.w	#100,d0
	bsr	beamdelay
	move.w	#100,d0
	bsr	beamdelay
	
    * init sprite, bitplane, whatever dma

    move.w #0x83E0,dmacon(a5)
 

	* install keyboard and vblank/copper handler
	move.l	system_vbr(pc),a1
	pea		level1_interrupt(pc)
	move.l	(a7)+,(0x64,a1)
	pea		level2_interrupt(pc)
	move.l	(a7)+,(0x68,a1)
	pea		level3_interrupt(pc)
	move.l	(a7)+,(0x6C,a1)
	pea		_nmi(pc)
	move.l	(a7)+,(0x7C,a1)

	* soundfx lib
	lea		_custom,a6
	lea		blank_sound,a0
	move.l	a0,(0xA0,a6)
	move.l	a0,(0xB0,a6)
	move.l	a0,(0xC0,a6)
	move.l	a0,(0xD0,a6)
	move.l	system_vbr(pc),a0
	moveq	#1,d0	| PAL
	jsr		_mt_install_cia


	
*	lea		hw_sprite_pointers,a0
*	move.w	#0x48,d7
*
*2:
*	move.b	#0x48,d0
*	move.b	#1,d1
*	jbsr	update_fg_tile
*	
*	addq	#1,d7
*	cmp.w	#0x400,d7
*	jne		2b
	
	
	
    rts
	
* < A0: palette
* < A1: copperlist
* < D0: number of colors to load	
load_palette:
	subq.w	#1,d0
	beq.b	2f
1:
	addq.w	#2,a1
	move.w	(a0)+,(a1)+
	dbf		d0,1b
2:
	rts
* < D0: row, if 0: do nothing
wrap_bitplanes:
	movem.l	a0-a2/d0-d3,-(a7)
	* first restore previous wrap if wasn't 0 TODO
	
	* if zero, we stop here, row 0 wraps naturally
	subq	#1,d0
	jmi		2f
	add.w	d0,d0
	add.w	d0,d0
 	lea	rows_table,a2
	add.w	d0,a2
	move.l	(a2),a1
	move.w	#COPPER_NOP,(0x8,a1)	| remove copjmp2, enable what's below
	add		#0x12,a1	| skip preamble
	move.w	#BG_SCREEN_PLANE_SIZE,d2
	move.w	#NB_PLAYFIELD_PLANES,d1
    move.l	playfield_displayed_screen_ptr(pc),d3
	* we should store A1 (double buffering)
1:
    swap d3
    move.w d3,(a1)
    swap d3
    move.w d3,(4,a1)    
    addq.w  #8,a1
    add.l d2,d3
    dbf d1,1b
2:
	movem.l	(a7)+,a0-a2/d0-d3
	rts
* < A0: copper block with rows
* < A1: part of the pointers list
* < D0: number of rows to fill

	.ifdef	NEED_ROWS
generate_row_table:
	* generate row table, set jumps
	move.w	#(first_rows_end-first_rows)/NB_FIRST_ROWS,d7	| block size
	subq	#1,d0
0:
	move.l 	a0,(a1)+
	lea		(a0,d7.w),a2	| next row jump
	move.l	a2,d1
	move.w	d1,(6+4,a0)
	swap	d1
	move.w	d1,(2+4,a0)
	move.l	a2,a0		| next row
	dbf		d0,0b
	rts
	.endif

	
	

* 60Hz VBLANK interrupt (also keyboard)
* only called at bootup, not from interrupts (at least!!)
osd_enable_interrupts:
	.if		OPT_BLIT_CHAIN_MODE==1
	* enable blitter, vblank & software level 1
	move.w	#0xC06C,_custom+intena
	.else
	* enable vblank & software level 1 only
	move.w	#0xC02C,_custom+intena
	.endif
	rts
osd_disable_interrupts:
	.if		OPT_BLIT_CHAIN_MODE==1
	* leave keyboard
	move.w	#0x0064,_custom+intena
	.else
	move.w	#0x0024,_custom+intena
	.endif
	rts
	


	
	

	
* set bank
* < D0.B bank 0-4
* > A1 bank pointer minus 0x4000
osd_set_bank:
	* make sure D5 is not used there!
	cmp.b	current_rom_bank,d0
	jeq		1f
	movem.l	d0/a0,-(a7)
	move.b	d0,current_rom_bank
	and.w	#0xFF,d0
	.ifndef	RELEASE
	cmp.b	#5,d0
	jcs		0f
	BREAKPOINT	"illegal bank index"
0:
	.endif
	lea		bank_table,a0
	.ifdef	NO68020
	add.w	d0,d0
	add.w	d0,d0
	move.l	(a0,d0.w),a1
	.else
	move.l	(a0,d0.w*4),a1
	.endif
	move.l	a1,bank_base
	
	movem.l	(a7)+,d0/a0
1:
	rts

* < A6: game memory

osd_weapon_palette_change:
	movem.l	d0/a0/a1,-(a7)
	moveq	#0,d0
	move.b	(weapon_type_0073,a6),d0	| current weapon type
	lsl.w	#3,d0
	lea		weapon_palettes,a0
	lea		osd_lower_palette+2,a1
	add.w	d0,a0
	* copy the 3 colors for weapon
	move.w	(a0)+,(a1)
	addq	#4,a1
	move.w	(a0)+,(a1)
	addq	#4,a1
	move.w	(a0)+,(a1)
	movem.l	(a7)+,d0/a0/a1
	rts
	
	
osd_video_word_dirty:
	jbsr	osd_video_byte_dirty
	addq	#1,a0
	jbsr	osd_video_byte_dirty
	subq	#1,a0
	rts
	
* a0=screen address (preserved)
* a6=ram base
* should preserve all registers
* allows 2000-3000 range
* 2000: foreground/HUD (2400: attributes)
* 2800: background
osd_video_byte_dirty:
	OSD_ENTER
	movem.l	d0-d7/a0-a2/a5,-(a7)
	move.b	(a0),d0
	move.l	a0,d7		| save address
	sub.l	a6,d7
	jmi		osd_w_videoram_out

	* we now suppose that we're in 2000-3000
	* check that in debug mode
	.ifndef		RELEASE
	cmp.w	#FG_SCREEN_TILE_ADDRESS+0x1000,d7
	jcs		0f
1:
	BREAKPOINT	"write videoram out of range (D7)"
	bra.b	osd_w_videoram_out	
0:
	.endif
	
	sub.w	#FG_SCREEN_TILE_ADDRESS,d7
	.ifndef	RELEASE
	jpl		0f
	add.w	#FG_SCREEN_TILE_ADDRESS,d7
	BREAKPOINT	"write videoram out of range (D7)"
	jra		osd_w_videoram_out
0:
	.endif
	
	cmp.w	#BG_SCREEN_TILE_ADDRESS-FG_SCREEN_TILE_ADDRESS,d7
	jcc		bg_tile
	
	and.w	#0x3FF,d7

	lea		(FG_SCREEN_TILE_ADDRESS,a6),a0
	move.b	(a0,d7.w),d0
	lea		(FG_SCREEN_COLOR_ADDRESS,a6),a0
	move.b	(a0,d7.w),d1

	* special case to get proper shield color
	cmp.w	#0x1F9,d7
	jne		0f
	* special location where the shield is
	* when the message appears if you kill level 6 bosses without it
	
	cmp.b	#0x86,d0
	jne		1f
	* shield is here: make palette change earlier
	move.w	#COPPER_NOP,weapon_palette_wait
	jra		0f
1:
	* shield is not here: palette change at the bottom
	move.w	weapon_palette_wait_value,weapon_palette_wait
0:

	jbsr	update_fg_tile

osd_w_videoram_out:
	movem.l	(a7)+,d0-d7/a0-a2/a5
	OSD_EXIT
	rts	
	
bg_tile:
	and.w	#0x3FF,d7
	
	* we need to see if the tile is on screen considering X scolling
	* positions. Compute first X & last X coord visible

	jbsr	compute_x_offset
	jmi		osd_w_videoram_out
	
	* tile is in screen considered the current scrolling: update it
	* (don't check Y we need update no matter when in that case)
	
	
	lea		(BG_SCREEN_TILE_ADDRESS,a6),a0
	move.b	(a0,d7.w),d0
	lea		(BG_SCREEN_COLOR_ADDRESS,a6),a0
	move.b	(a0,d7.w),d1


	* here we have to compute x_offset, this is the game displaying a random
	* tile on screen

	jbsr	update_bg_tile

	jra		osd_w_videoram_out
	
	
	.macro	COPY_TILE8_PLANE_ROW
	move.b	d0,(offset,a1)  | buffer
	.endm
	
	.macro	CLEAR_TILE8_PLANE
	.set	offset,0
	.rept	8
	clr.b	(offset,a1)
	.set	offset,offset+FG_NB_BYTES_PER_ROW
	.endr	
	.endm
	
	.macro	TILE8_NEXT_PLANE
	add.l	d5,a1
	add.l	d5,a2
	.endm

* compute X offset (0,0x40,0x80 ...) that makes up for
* corkscrew effect
* !only valable for a single random tile poke, not for a scroll column update
* that computes its own x_offset!
* < D7: address (0-0x400)
* > N: set not in visible screen
* > x_offset: updated
compute_x_offset:
	movem.w	d1-d2,-(a7)
	* we need to see if the tile is on screen considering X scolling
	* positions. Compute first X & last X coord visible
	clr.w	x_offset
	move.w	d7,d2
	lsr.w	#5,d2
	
	* establish min & max bounds including invisible tile used for scroll
	* which is outside the screen
	move.w	game_scroll_x,d0  | left of screen
	lsr.w	#4,d0		| divide by 16 match tile
	move.w	d0,d1
	add.w	#0x12,d1	| right part
	
	* is min X < d2
	cmp.b	d0,d2
	jcc		0f
	move.w	d1,d3
	and.w	#0x1F,d3
	cmp.w	d0,d3
	jcc		0f
	* handle wrap
	add.w	#0x20,d2
	move.w	#0x40,x_offset		| wrapped: add 0x40 offset
0:
	cmp.w	d0,d2
	jcs		10f
	add.w	#0x11,d0			| visible tile span (including invisible scroll column)
	cmp.b	d0,d2
	jcc		10f	| tile x+screen width < scroll x

	* tile is in screen: return x offset (0, 0x40, 0x80 ...)
	
	move.w	host_scroll_x,d0
	* now reduce 0x200 => 0x40
	lsr.w	#8,d0
	lsr.w	#1,d0
	lsl.w	#6,d0
	add.w	d0,x_offset	
2:
	movem.w	(a7)+,d1-d2
	rts
10:
	moveq	#-1,d0
	jra		2b
	
* create 2 caches

cache_bg_tiles_address:
	* 1 cache: tile-accurate X,Y => address
	lea		bg_tile_xy2address_cache,a0
	moveq	#0,d1
0:
	moveq	#0,d0
1:
	move.w	d0,d2
	lsl.w	#5,d2		| X*32
	add.w	d1,d2		| plus Y
	move.w	d2,(a0)+
	addq	#1,d0
	cmp.w	#0x20,d0
	jne		1b
	addq	#1,d1
	cmp.w	#0x20,d1
	jne		0b
	
	* 2 cache: address => tile-accurate X,Y
	lea		bg_tile_address2xy_cache,a0
	move.w	#0,d7
0:
	move.w	d7,d0
	lsr.w	#5,d0
	lsl.w	#8,d0
	move.w	d7,d1
	and.b	#0x1F,d1
	or.b	d1,d0
	move.w	d0,(a0)+
	addq	#1,d7
	cmp.w	#0x400,d7
	jne		0b
	
	rts
	
	.macro	COPY_TILE16_PLANE_ROW
	move.w	d0,(offset,a1)  | buffer
	move.w	d0,(offset,a3)  | restore buffer
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	move.w	d0,(offset,a4)	| second buffer
	.endif
	.endm
	
	.macro	CLEAR_TILE16_PLANE
	.set	offset,0
	.rept	16
	clr.w	(offset,a1)
	clr.w	(offset,a3)  | restore buffer
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	clr.w	(offset,a4)	| second buffer
	.endif
	.set	offset,offset+BG_NB_BYTES_PER_ROW
	.endr	
	.endm
	

	
	.macro	TILE16_NEXT_PLANE
	.if	BG_SCREEN_PLANE_SIZE>0x7FFF
	add.l	d5,a1
	add.l	d5,a3
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	add.l	d5,a4
	.endif
	.else
	add.w	d5,a1
	add.w	d5,a3
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	add.w	d5,a4
	.endif
	
	.endif
	.endm
	
* < D7: 0-0x400 address
* < D0: tile code
* < D1: color code
* uses x_offset computed from scrolling current params

update_bg_tile:
	moveq	#0,d2			| mask up to 255
	move.b	d0,d2			| tile code
	moveq	#0,d3
	move.b	d1,d3			| CLUT & tile code & flags

	move.w	d3,d4
	and.b	#0xC0,d4
	add.w	d4,d4
	add.w	d4,d4
	add.w	d4,d2			| full tile code

	* compute address
	
	move.w	d7,d0
	lsr.w	#5,d0	| divide by 0x20
	add.w	d0,d0	| 16 pixels
	add.w 	x_offset,d0		| add corkscrew makeup offset

	move.w	d7,d1
	subq.w	#1,d1		| first row is not shown with y scroll = 0
	and.w	#0x1F,d1	| modulus 0x20
	tst.b	must_mirror_y_tiles
	jeq		666f
	cmp.w	#0x10,d1
	scs		d6			| repeat tile draw if Y tile  < 0x10
	jra		667f
666:
	* full horizontal level: don't draw anything below tile 0x10, don't mirror
	sf		d6
	cmp.w	#0x10,d1
	jcs		667f
	* do nothing, this tile will never be shown
	rts
667:
	* updating bitplanes
	.if	BG_SCREEN_PLANE_SIZE>0x7FFF
	move.l	#BG_SCREEN_PLANE_SIZE,d5
	.else
	move.w	#BG_SCREEN_PLANE_SIZE,d5
	.endif
	
	move.l		playfield_drawed_screen_ptr,a1
	.ifeq	OPT_ENABLE_DOUBLE_BUFFERING
	.else 
	* double buffering
	move.l		playfield_displayed_screen_ptr,a4
	.endif
	
	move.w	#NB_BG_PLANES-1,d4   | needed even if no tile
	lea		mulBG_NB_BYTES_PER_ROW_table,A2
	.ifdef	NO68020
	add.w	d1,d1
	move.w	(a2,d1.w),d1
	.else
	move.w	(a2,d1.w*2),d1
	.endif
	lsl.w	#4,d1	| 16 pixels
	add.w	d1,d0
	add.w	d0,a1
	.ifeq	OPT_ENABLE_DOUBLE_BUFFERING
	.else 
	* double buffering
	add.w	d0,a4
	.endif

	lea		background_restore_buffer,a3
	add.w	d0,a3

	
	*cmp.b	#0x20,d2
	*jeq		11f				| optim: blank tile
	move.l		bg_tile_character_table,d0
	jeq		100f			| no context loaded: out
	move.l	d0,a0
	.ifdef	NO68020
	add.w	d2,d2
	add.w	d2,d2	
	move.l	(a0,d2.w),d0		| tile pointer
	.else
	move.l	(a0,d2.w*4),d0		| tile pointer
	.endif
	.ifdef	RELEASE
	jeq		11f					| clear tile, no error (release)
	.else
	jne		12f
	move.w	d7,-(a7)
	add.w	#BG_SCREEN_TILE_ADDRESS,d7
	.ifdef	NO68020
	lsr.w	#2,d2
	.endif
	*COLOR0_FLASH	0xF0F
	move.w	(a7)+,d7
	jra		11f
12:
	.endif
	move.l	d0,a2
	move.w	d3,d1		| save attributes
	lsr.w	#4,d1
	and.w	#3,d1		| mirror/flip
	
	and.w	#0x7,d3
	.ifdef	NO68020
	add.w	d3,d3
	add.w	d3,d3
	move.l	(a2,d3.w),d0			| pointer on tile bitplanes for that CLUT
	.else
	move.l	(a2,d3.w*4),d0			| pointer on tile bitplanes for that CLUT	
	.endif
	.ifdef	RELEASE
	jeq		11f						| not necessarily a problem
	.else
	jne		12f
	move.w	d7,-(a7)
	add.w	#BG_SCREEN_TILE_ADDRESS,d7
	lsr.w	#2,d2
	lsr.w	#2,d3
	*COLOR0_FLASH	0xFF0
	move.w	(a7)+,d7
	jra		11f
	.endif
12:
	move.l	d0,a2					| pointer on bitplanes


	lea		mirror_jump_table,a0
	.ifdef	NO68020
	add.w	d1,d1
	add.w	d1,d1
	move.l	(a0,d1.w),a0
	.else
	move.l	(a0,d1.w*4),a0
	.endif
	
	* we wait just in case a blitter operation is in progress
	* it rarely conflicts, as only animated tiles are the windows at level 2
	* from where the flying small pests arrive
	*lea		_custom,a5
	*REALLY_WAIT_BLIT
	tst.b 	d6
	jeq		0f
	movem.l	d0-D3/a0-a6,-(a7)
	jsr		(a0)
	* lower part too
	movem.l	(a7)+,d0-D3/a0-a6
	move.w	#2*BG_SCREEN_PLANE_SIZE/3,d6
	add.w	d6,a1
	add.w	d6,a3
	.ifne	OPT_ENABLE_DOUBLE_BUFFERING
	add.w	d6,a4
	.endif
	move.w	#NB_BG_PLANES-1,d4
0:
	jmp		(a0)

standard_tile16:

	* just copy

4:
	move.l	(a2)+,d0		| next plane
	jeq		5f
	move.l	d0,a0
	.set	offset,0
	.rept	16
	move.w	(a0)+,d0
	COPY_TILE16_PLANE_ROW
	.set	offset,offset+BG_NB_BYTES_PER_ROW
	.endr
41:
	TILE16_NEXT_PLANE
	dbf		d4,4b
	
100:
	rts
5:
	CLEAR_TILE16_PLANE
	jra		41b


flipped_tile16:	
4:
	move.l	(a2)+,d0		| next plane
	jeq		5f
	move.l	d0,a0
	.set	offset,8*BG_NB_BYTES_PER_ROW
	.rept	16
	.set	offset,offset-BG_NB_BYTES_PER_ROW
	move.w	(a0)+,d0
	COPY_TILE16_PLANE_ROW
	.endr
41:
	TILE16_NEXT_PLANE
	dbf		d4,4b
	
0:
	rts
5:
	CLEAR_TILE16_PLANE
	jra		41b

	
mirror_tile16:
	move.l	a5,-(a7)
	lea		mirror_table,a5
	.ifdef	MC68020
	moveq	#0,d1
	.endif
4:
	move.l	(a2)+,d0		| next plane
	jeq		5f
	move.l	d0,a0
	.set	offset,0
	.rept	16
	.ifdef	MC68020
	move.w	(a0)+,d1
	move.w	(a5,d1.l*2),d0	| mirror
	.else
	moveq	#0,d1	
	move.w	(a0)+,d1
	add.l	d1,d1
	move.w	(a5,d1.l),d0	| mirror
	.endif
	COPY_TILE16_PLANE_ROW

	.set	offset,offset+BG_NB_BYTES_PER_ROW
	.endr
41:
	TILE16_NEXT_PLANE
	dbf		d4,4b
	move.l	(a7)+,a5
	rts

5:
	CLEAR_TILE16_PLANE
	jra		41b
	
mirror_flipped_tile16:
	move.l	a5,-(a7)
	lea		mirror_table,a5
	.ifdef	MC68020
	moveq	#0,d1
	.endif
4:
	move.l	(a2)+,d0		| next plane
	jeq		5f
	move.l	d0,a0
	.set	offset,8*BG_NB_BYTES_PER_ROW
	.rept	16
	.set	offset,offset-BG_NB_BYTES_PER_ROW
	.ifdef	MC68020
	move.w	(a0)+,d1
	move.w	(a5,d1.l*2),d0	| mirror
	.else
	moveq	#0,d1	
	move.w	(a0)+,d1
	add.l	d1,d1
	move.w	(a5,d1.l),d0	| mirror
	.endif
	COPY_TILE16_PLANE_ROW
	.endr
41:
	TILE16_NEXT_PLANE
	dbf		d4,4b
	move.l	(a7)+,a5
	rts

5:
	CLEAR_TILE16_PLANE
	jra		41b

	* clear tile

11:
111:
	CLEAR_TILE16_PLANE
	TILE16_NEXT_PLANE
	dbf		d4,111b
2:
	rts

mirror_jump_table:
	.long	standard_tile16
	.long	mirror_tile16
	.long	flipped_tile16
	.long	mirror_flipped_tile16
	
	
cache_fg_tiles_address:
	moveq	#0,d7
	lea		fg_tile_address_table,a0
0:
	jbsr	compute_fg_tile_xy

	move.b	d0,(a0)+		| store offset
	move.b	d1,(a0)+		| store offset

	addq.w	#1,d7
	cmp.w	#0x400,d7
	jne		0b
	rts


* < D7: 0-0x400
* > D0/D1: coords 
compute_fg_tile_xy:
	moveq	#0,d0
	move.b	d7,d0
	
	and.b	#0x1F,d0	| x
	move.w	d7,d1
	lsr.w	#5,d1		| Y
	and.b	#0x1F,d1	| Y
	subq	#2,d1		| 2 first rows aren't visible
	lsl.w	#3,d1		| times 8
	rts

*compute_tile_xy_portrait:
*	moveq	#0,d0
*	moveq	#0,d1
*	move.w	d7,d1
*	lsr.w	#5,d7		| this is X
*	neg.w	d7
*	add.w	#32,d7
*	and.w	#0x1F,d1	| this is Y
*	*addq.w	#2,d1
*
*	move.b	d7,d0		| this is X
*	lsl.b	#3,d1		| Y times 8
*	rts



	.macro	NEXT_SOURCE_PLANE
	move.l	(a4)+,d0		| next plane
	jne		5f
	move.l	#empty_row,d0
5:	
	move.l	d0,a0
	.endm

* < D7: 0-0x400 offset
* < D0: tile code
* < D1: tile attribute

update_fg_tile:
	* if < 0x40 bail out as not visible
	cmp.w	#0x40,d7
	jcc		0f
	rts
0:
	moveq	#0,d2
	moveq	#0,d3
	move.b	d0,d2	| code
	move.b	d1,d3	| attribute + tile msbits
	and.w	#0xC0,d3
	lsl.w	#2,d3
	add.w	d3,d2	| extended tile code
	move.b	d1,d3	| attribute + tile msbits
	and.w	#0xF,d3	| clut

	* if weapon frame is written, install palette change branch
	cmp.w	#0x34E,d7
	jne		0f
	lea		osd_lower_palette_switch,a0
	move.w	#copjmp2,(a0)
	cmp.b	#0xA0,d0
	jne		0f
	move.w	#COPPER_NOP,(a0)		| activate weapon & frame palette
0:
	lea		fg_tile_address_table,a1
	move.l	a1,0x110
	.ifdef	NO68020
	add.w	d7,d7
	move.w	(a1,d7.w),d0
	.else
	move.w	(a1,d7.w*2),d0
	.endif
	moveq	#0,d1
	move.b	d0,d1
	rol.w	#8,d0
	and.w	#0xFF,d0
	
	* select which destination sprites (0-3)
	move.w	d0,d4
	lea		hw_sprite_pointers,a1
	and.w	#0xF8,d4		| divide by 8
							| then multiply by 8 (sprite go by pairs)
	lea	(a1,d4.w),a1

	
	and.w	#0x7,d0		| dest X offset
	lsl.w	#4,d1		| dest Y offset (8*2 pixels per row)
	add.w	d0,d1
	add.w	#0x10,d1	| skip control word
	
	* get 2 pointers for 2 attached sprites
	move.l	(a1)+,a2
	move.l	(a1),a1
	

	exg		a1,a2
	* add offset to destination
	add.w	d1,a2
	add.w	d1,a1
	
	* now get source data
	lea		fg_character_table,a0
	

20:

	* updating bitplanes

	.ifdef	MC68020
	move.l	(a0,d2.l*4),d0		| tile pointer as LONG!
	.else
	add.w	d2,d2
	add.w	d2,d2	
	move.l	(a0,d2.l),d0		| tile pointer as LONG!
	.endif
	
	.ifdef	RELEASE
	jeq		11f 	| can happen when tile code is read when screen is being erased	
	.else
	jne		12f
	.ifndef	MC68020
	lsr.w	#2,d2
	.endif
	add.w	#FG_SCREEN_TILE_ADDRESS,d7
	**COLOR0_FLASH	0x00F
	*BREAKPOINT	"unregistered game tile (in D2, at address D7)"	

	jra		11f
	.endif
12:
	move.l	d0,a4
	.ifdef	MC68020
	move.l	(a4,d3.w*4),d0	| get proper clut
	.else
	add.w	d3,d3
	add.w	d3,d3	
	move.l	(a4,d3.w),d0	| get proper clut
	.endif
	jeq		11f
	
	
	move.l	d0,a4		| directly pointer on tile bitplanes
	
	
*standard_tile:
	* first plane: first sprite
	NEXT_SOURCE_PLANE
	.set	offset,0
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a1)
	.set	offset,offset+16
	.endr
	* second plane: first sprite, with a 8 offset
	NEXT_SOURCE_PLANE
	.set	offset,8
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a1)
	.set	offset,offset+16
	.endr
	* third plane: second sprite
	NEXT_SOURCE_PLANE
	.set	offset,0
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a2)
	.set	offset,offset+16
	.endr
	* second plane: second sprite, with a 8 offset
	NEXT_SOURCE_PLANE
	.set	offset,8
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a2)
	.set	offset,offset+16
	.endr

11:
	rts


empty_row:
	.skip	8
		
* < d0.w: x
* < d1.w: y
* < a1: sprite pos table (depending on height)
* > d0.L: control word
store_sprite_pos:
	tst.w	d1
	jmi	0f
	cmp.w	#Y_MAX,d1
	jcc	0f

    move.l  a0,-(a7)

    lea	HW_SpriteXTable(pc),a0
	
	.ifndef	MC68020
    add.w	d0,d0
    add.w	d0,d0
    move.l	(a0,d0.w),d0
	move.w	d1,-(a7)
    add.w	d1,d1
    add.w	d1,d1
    or.l	(a1,d1.w),d0
	move.w	(a7)+,d1
	.else
    move.l	(a0,d0.w*4),d0
    or.l	(a1,d1.w*4),d0	
	.endc
    move.l  (a7)+,a0
    rts
0:
	moveq	#0,d0
	rts
	



HW_SpriteXTable:
	.set	reptn,0
	.rept 320
	.set	x,reptn+0x80
	.set reptn,reptn+1
    .byte  0,x>>1,0,x&1
  .endr

	.macro DEF_HW_SPRITE_Y_TABLE	height
HW_SpriteYTable_\height:
  .set	reptn,0
  .rept 288
	.set	ys,reptn+0x1c
	.set	ye,ys+\height
    .byte  ys&255, 0, ye&255, ((ys>>6)&4)+((ye>>7)&2)
	.set	reptn,reptn+1
  .endr
	.endm

	DEF_HW_SPRITE_Y_TABLE	256


set_bobs_bitplanes:
	movem.l	a0-a1/d0-d2,-(a7)
	
	* set bitplanes
	moveq	#0,d0
	move.w	game_scroll_y,d0

	lea		mulBG_NB_BYTES_PER_ROW_table,a2
	.ifdef	MC68020
	move.w	(a2,d0.w*2),d0		| compute Y offset
	.else
	add.w	d0,d0
	move.w	(a2,d0.w),d0		| compute Y offset
	.endif
1:	
	move.w	host_scroll_x,d2
	and.w	#0x0FF,d2			| wraps at 0x100!

	lea		scroll_table,a2
	.ifdef	MC68020
	lea		(a2,d2.w*4),a2
	.else
	add.w	d2,d2
	add.w	d2,d2
	add.w	d2,a2
	.endif
	
	move.w	(a2)+,fine_x_scroll_value
	move.w	host_scroll_x,d2
	lsr.w	#6,d2
	lsl.w	#3,d2
	add.w	d2,d0
	
	
    moveq #NB_PLAYFIELD_PLANES-1,d1
 	move.l	#BG_SCREEN_PLANE_SIZE,d2
	.ifndef	RELEASE
	* quick check just in case someone uses that with plane size > 0x7FFF
	jpl		10f
	BREAKPOINT	"negative plane size!"
10:
	.endif
2:
    move.l	playfield_displayed_screen_ptr(pc),a0
	
	add.l	d0,a0		| X/Y scroll offset (long!)
	move.l	a0,d0		| first bitplane screen pointer
 	lea	bobs_bitplanes+2,a0
1:
    swap d0
    move.w d0,(a0)
    swap d0
    move.w d0,(4,a0)    
    addq.w  #8,a0
    add.l d2,d0
    dbf d1,1b
	movem.l	(a7)+,a0-a1/d0-d2
    rts

scroll_table:
	* generated by python script
	.ifne	OPT_AGA_MODE
	.include	"scroll_table_64.68k"
	.else
	.include	"scroll_table_16.68k"
	.endif
	
	.include	"palette.68k"
osd_debug_hook:
	rts
	
	

osd_read_p1_inputs:
	move.b	 player_1_controls,d0
	rts


osd_read_p2_inputs:
	st.B	d0
	rts
	


	
	.ifne	OPT_ENABLE_LOGGING
purge_tile_log_data:
	movem.l	d0-a6,-(a7)
	lea		fg_tile_log_table,a0
	lea		fg_tile_log_table_end,a1
0:
	clr.l (a0)+
	cmp.l	a0,a1
	jne		0b
	
	
	movem.l	(a7)+,d0-a6
	rts
purge_sprite_log_data:
	movem.l	d0-a6,-(a7)
	lea		sprite_log_table,a0
	lea		sprite_log_table_end,a1
0:
	clr.l (a0)+
	cmp.l	a0,a1
	jne		0b
	movem.l	(a7)+,d0-a6
	rts
	.endif

	
* < D1: previous state
update_controls:
	moveq	#-1,d0

	lea		keyboard_table(pc),a0

	tst.b	(0x4C,a0)		| "up" key
	beq.b	0f
	bclr	#BIT_UP,d0
0:
	tst.b	(0x4D,a0)		| "down" key
	beq.b	0f
	bclr	#BIT_DOWN,d0
0:
	tst.b	(0x4F,a0)		| "<-" key
	beq.b	0f
	bclr	#BIT_LEFT,d0
0:
	tst.b	(0x4E,a0)		| "->" key
	beq.b	0f
	bclr	#BIT_RIGHT,d0
0:
	tst.b	(0x63,a0)		| "ctrl" key
	beq.b	0f
	bclr	#BIT_FIRE_1,d0
0:
	tst.b	(0x64,a0)		| left "alt" key
	beq.b	0f
	bclr	#BIT_FIRE_2,d0
0:

	* directions + fire
	move.l	joypad_1_state(pc),d1
	jbsr	decode_joypad_controls
	move.b	d0,player_1_controls

	


	rts
	
decode_joypad_controls:
	btst	#JPB_BTN_UP,d1
	beq.b	0f
	bclr	#BIT_UP,d0
0:
	btst	#JPB_BTN_DOWN,d1
	beq.b	0f
	bclr	#BIT_DOWN,d0
0:
	btst	#JPB_BTN_LEFT,d1
	beq.b	0f
	bclr	#BIT_LEFT,d0
0:
	btst	#JPB_BTN_RIGHT,d1
	beq.b	0f
	bclr	#BIT_RIGHT,d0
0:
	btst	#JPB_BTN_RED,d1
	beq.b	0f
	bclr	#BIT_FIRE_1,d0
0:
	btst	#JPB_BTN_BLU,d1
	beq.b	0f
	bclr	#BIT_FIRE_2,d0
0:
	rts
	

osd_read_dsw1:
	* actual dipswitches
	move.b	dip_switches_1,d0	| what MAME returns by default: demo sounds on. ~0x60: service mode
	rts

osd_read_dsw2:
	* actual dipswitches
	move.b	dip_switches_2,d0	| what MAME returns by default
	rts
	
osd_read_system:
	st.b	d0
	movem.l	a0/d1,-(a7)
	lea		keyboard_table(pc),a0
	tst.b	coin1_requested
	jeq		0f
	subq.b	#1,coin1_requested
	st.b	detect_controllers
	bclr	#BIT_COIN1,d0
0:

	tst.b	coin2_requested
	beq.b	0f
	subq.b	#1,coin2_requested
	st.b	detect_controllers
	bclr	#BIT_COIN2,d0
0:	
	tst.b	(1,a0)		| "1" key like in MAME
	beq.b	0f
	st.b	detect_controllers
	bclr	#BIT_START_1P,d0
0:	
	tst.b	(2,a0)		| "2" key like in MAME
	beq.b	0f
	st.b	detect_controllers
	bclr	#BIT_START_2P,d0
0:	

	jbsr		is_game_playing
	jeq	1f
	move.l	joypad_1_state,d1

	* game not playing, we can insert coin/start with joypad
	btst	#JPB_BTN_RED,d1		| "5" key like in MAME
	jeq		0f
	st.b	detect_controllers
	bclr	#BIT_COIN1,d0
0:
	btst	#JPB_BTN_UP,d1		| "1" key like in MAME
	jeq		0f
	st.b	detect_controllers
	bclr	#BIT_START_1P,d0
0:
	btst	#JPB_BTN_DOWN,d1		| "2" key like in MAME
	jeq		0f
	st.b	detect_controllers
	bclr	#BIT_START_2P,d0
0:

1:	
	movem.l	(a7)+,a0/d1
	rts

	

	

level2_interrupt:
	jbsr		handle_keyboard
	move.w	#8,_custom+intreq
	rte
	
	
*TILE_GET_INFO_MEMBER(vball_state::get_bg_tile_info)
*{
*	uint8_t code = m_videoram[tile_index];
*	uint8_t attr = m_attribram[tile_index];
*	tileinfo.set(0,
*			code + ((attr & 0x1f) << 8) + (m_gfxset << 8),
*			(attr >> 5) & 0x7,
*			0);
*}


	.ifne	OPT_ENABLE_LOGGING
log_used_fg_tiles:
	* scan the whole screen, see what was updated
	* main screen

	GET_MEMORY_START_IN_A6
	lea		(FG_SCREEN_TILE_ADDRESS,a6),a5
	lea		(FG_SCREEN_COLOR_ADDRESS,a6),a4
	lea		fg_tile_log_table,a0
	move	#(1<<FG_TILE_NB_CLUTS_POW)-1,d4		| clut mask
	move	#FG_TILE_NB_CLUTS_POW,d5		| nb clut pow
	jra		log_any_tiles
	
log_used_bg_tiles:
	* scan the whole screen, see what was updated
	* main screen

	GET_MEMORY_START_IN_A6
	lea		(BG_SCREEN_TILE_ADDRESS,a6),a5
	lea		(BG_SCREEN_COLOR_ADDRESS,a6),a4
	lea		bg_tile_log_table,a0
	move	#(1<<BG_TILE_NB_CLUTS_POW)-1,d4		| clut mask
	move	#BG_TILE_NB_CLUTS_POW,d5		| nb clut pow

log_any_tiles:
	move.w	#0x800-1,d7
0:
	tst.b	must_mirror_y_tiles
	jne		1f
	* if Y is > 0x10 don't log (that will be trash from previous level)
	move.w	d7,d0
	and.w	#0x1F,d0
	cmp.w	#0x10,d0
	jcs		1f
	sub.w	#0x10,d7		| skip 10 rows
1:
	moveq	#0,d1
	moveq	#0,d0
	move.b	(a5,d7.w),d0	| tile code
	move.b	(a4,d7.w),d1	| tile attribute

	moveq	#0,d2
	moveq	#0,d3
	move.b	d0,d2	| code
	move.b	d1,d3	| attribute + tile msbits
	and.w	#0xC0,d3
	lsl.w	#2,d3
	add.w	d3,d2	| extended tile code
	move.b	d1,d3	| attribute + tile msbits
	and.w	d4,d3	| clut masked

	| remove flip/mirror
	lsl.l	d5,d2			| tile code * NB_CLUTS (long!)
	add.l	d3,d2			| add clut
	st.b	(a0,d2.l)
20:
	dbf		d7,0b
	rts
	
* sprite_log, log_sprites
log_used_sprites:

	* scan the whole screen, see what was updated
	* main screen
	
	GET_MEMORY_START_IN_A6
	lea		(SPRITE_ADDRESS,a6),a5
	lea	sprite_log_table,a0
	moveq	#0,d7
0:
	cmp.b	#0xF8,(TARGET_SPRITE_Y,a5,d7.w)
	jeq		1f			| not active
	moveq	#0,d2
	moveq	#0,d1
	moveq	#0,d0
	move.b	(TARGET_SPRITE_CODE,a5,d7.w),d0
	move.b	(TARGET_SPRITE_ATTRIBUTES,a5,d7.w),d1
	move.b	d1,d2
	* extended tile code
	lsl.w	#2,d2
	and.w	#0x300,d2
	add.w	d2,d0
	lsr.b	#4,d1
	and.w	#SPRITE_NB_CLUTS-1,d1
	
	lsl.l	#SPRITE_NB_CLUTS_POW,d0			| sprite code * NB_CLUTS (long!)
	add.l	d1,d0			| add clut

	st.b	(a0,d0.l)
1:
	addq	#TARGET_SPRITE_SIZEOF,d7
	cmp.w	#NB_TARGET_SPRITES*TARGET_SPRITE_SIZEOF,d7
	jne		0b
	rts
	.endif
	
redraw_bg_tiles:
	movem.l	d0-a6,-(a7)
	jbsr 	force_all_screen_redraw
	movem.l	(a7)+,d0-a6
	rts
	
skip_level:
	movem.l	d0-a6,-(a7)
	GET_MEMORY_START_IN_A6
	cmp.b	#1,(sub_sub_state_0008,a6)
	jne		0f
	cmp.b	#6,(current_level_0072,a6)
	jcc		0f
	clr.b	(sub_sub_state_0008,a6)
	clr.b	(sub_sub_sub_state_000b,a6)
	clr.b	(0xE,a6)
	addq.b	#1,(current_level_0072,a6)
0:
	movem.l	(a7)+,d0-a6
	rts
	
warp_on_top_of_screen:
	movem.l	d0-a6,-(a7)
	GET_MEMORY_START_IN_A6
	st.b	(0x50A,a6)

	movem.l	(a7)+,d0-a6
	rts
	
handle_keyboard:
	movem.l	D0/A0/A5,-(a7)
	LEA	0x00BFD000,A5
	MOVEQ	#0x08,D0
	AND.B	0x1D01(A5),D0
	jeq		1f
	MOVE.B	0x1C01(A5),D0
	NOT.B	D0
	ROR.B	#1,D0		| raw key code here
  
	CLR.B	0x1C01(A5)
  
    lea keyboard_table(pc),a0
    bclr    #7,d0
    seq (a0,d0.w)       | updates keyboard table
    jne   2f     | we don't care about key release
	
	* to insert a credit, game needs a short pulse
	* so maintaining the key too long would fail. But too
	* short would not work either. 10 ticks seems to work
	cmp.b	#5,d0	| "5" key like in MAME
	bne.b	0f
	move.b	#10,coin1_requested
0:
	cmp.b	#6,d0	| "5" key like in MAME
	bne.b	0f
	move.b	#10,coin2_requested
0:

    cmp.b   #0x19,d0	| "P" key
    bne.b   0f

    bsr	toggle_pause
0:

	* last life, time=0, direct game over
	cmp.b	#69,d0	| F8 key: set time at 0
	bne.b	0f
	jbsr	lose_all_lives
0:


	* cheat keys are always active in dev mode
	.ifdef	RELEASE
	btst	#4,cheat_flags+3
	jeq		10f
	.endif
	* cheat keys


	cmp.b	#0x50,d0	| F1 key: toggle invincible
	bne.b	0f
	st.b	cheat_used
	not.b	invincible_flag
	COLOR0_FLASH	0x0FF
	
0:
	cmp.b	#0x51,d0	| F2 key: skip level
	bne.b	0f
	st.b	cheat_used
	jbsr	skip_level
	COLOR0_FLASH	0x0FF
	
0:
	cmp.b	#0x52,d0	| F3 key: change weapon
	bne.b	0f
	st.b	cheat_used
	jbsr	cycle_weapon
	
0:

	cmp.b	#0x53,d0	| F4 key: warp on top of scren
	bne.b	0f
	st.b	cheat_used
	COLOR0_FLASH	0x0FF
	jbsr	warp_on_top_of_screen
0:
	cmp.b	#0x54,d0	| F5 key
	bne.b	0f
	st.b	cheat_used
	COLOR0_FLASH	0x0FF
	jbsr	add_to_score
0:

10:
	.ifndef	RELEASE
	cmp.b	#34,d0
	bne		0f
	* 'D': dump all logging buffers to data dir
	jbsr	osd_dump_logs
0:

	
	cmp.b	#0x55,d0	| F6 key: debug params
	bne.b	0f
	COLOR0_FLASH	0x0FF
	jbsr	redraw_bg_tiles
0:
	cmp.b	#0x56,d0	| F7 key: debug params
	bne.b	0f
	eor.b		#1,osd_debug_active
0:
	cmp.b	#0x58,d0	| F9 key crashes game (restarts whdload)
	bne.b	0f
	illegal
0:

	.endif

	cmp.b	_keyexit,d0	| "ESC" key or whdload quitkey
	bne.b	2f
	BSET	#0x06,0x1E01(A5)
	moveq	#2,d0
	bsr	beamdelay
	BCLR	#0x06,0x1E01(A5)	| acknowledge key
	bra		quit_to_os
2:
	BSET	#0x06,0x1E01(A5)
	moveq	#2,d0
	bsr	beamdelay
	BCLR	#0x06,0x1E01(A5)	| acknowledge key

1:
	movem.l	(a7)+,d0/a0/a5
	rts
	
toggle_pause:
	* pause only within game
	jbsr		is_game_playing
	*beq.b	0f
	eor.b   #1,pause_flag
0:
	rts

	

    
* < D0: numbers of vertical positions to wait
beamdelay:
0:
	move.w  d0,-(a7)
    move.b	0xdff006,d0	| VPOS
1:
	cmp.b	0xdff006,d0
	beq.s	1b
	move.w	(a7)+,d0
	dbf	d0,0b
	rts

	
	MUL_TABLE	BG_NB_BYTES_PER_ROW,BG_NB_LINES
	MUL_TABLE	FG_NB_BYTES_PER_ROW,FG_NB_LINES

	.align	4		| leave this long word alignment
program_args:	ds.l	64,0
program_args_end:
	.long	0		| add a longword else it overwrites the read args string in kick 1.3!
	.align	4
read_args_string:
	.byte	read_args_string_end-read_args_string
	.ascii	"CHEATKEYS/S,FIVELIVES/S,FAST/S"
read_args_string_end:
	.align	2

* < A0: highscore buffer
osd_read_high_scores:
	OSD_ENTER
	movem.l	d0-d7/a0-a6,-(a7)
	GET_MEMORY_START_IN_A6
	lea	(high_score_table_1518,a6),a0
	move.l	_resload,d0
	beq.b	0f
	move.l	d0,a2
	move.l	a0,a1
	bsr		get_hiscore_name
	move.l	a1,-(a7)
 	jsr		resload_GetFileSize(a2)		
	move.l	(a7)+,a1
	tst.l	d0
	beq.b	1f
	bsr		get_hiscore_name
	jsr		resload_LoadFile(a2)	
	bra.b	1f
0:
	tst.b	highscore_loaded
	beq.b	1f

	* from DOS: just copy buffer
	lea		high_score_buffer,a1
	move.w	#SCORE_FILE_SIZE-1,d0
0:
	move.b	(a1)+,(a0)+
	dbf		d0,0b
1:
	lea	(high_score_table_1518,a6),a0
	move.w	(a0),d0		| offset for highest score
	lea		(a6,d0.w),a0
	* also update copy (for top screen display)
	lea	(high_score_00d0,a6),a1
	move.l	(a0),(a1)
	movem.l	(a7)+,d0-d7/a0-a6
	OSD_EXIT
	rts
	
* < A0: highscore buffer
osd_write_high_scores:
	OSD_ENTER
	movem.l	d0-d7/a0-a6,-(a7)
	.ifdef	RELEASE
	tst.b	cheat_used		| don't save score if cheat on
	bne.b	2f
	.endif
	GET_MEMORY_START_IN_A6
	lea	(high_score_table_1518,a6),a0
	
	move.l	_resload,d0
	bne.b	1f
	* DOS
	* first just copy buffer as contiguous 
	lea		high_score_buffer,a1
	move.w	#SCORE_FILE_SIZE-1,d0
0:
	move.b	(a0)+,(a1)+
	dbf		d0,0b
	st.b	highscore_needs_saving
	jra		2f
1:
	* whdload
	move.l	a0,a1
	move.l	d0,a2
	move.l	#SCORE_FILE_SIZE,d0
	bsr		get_hiscore_name
	jsr		resload_SaveFile(a2)
2:

	movem.l	(a7)+,d0-d7/a0-a6
	OSD_EXIT
	rts

	
get_hiscore_name:
    lea normal_hiscorename,a0
	rts
	
load_highscores:
    move.l  _resload,d0
    bne.b   1f

	bsr.b		get_hiscore_name
    move.l  _dosbase,a6
    move.l  a0,d1
    move.l  #1005,d2
    jsr     (_LVOOpen,a6)
    move.l  d0,d1
    beq.b   1f
    move.l  d1,d4
    move.l  #SCORE_FILE_SIZE,d3
    move.l  #high_score_buffer,d2
    jsr (_LVORead,a6)
    move.l  d4,d1
    jsr (_LVOClose,a6)   
	st.b	highscore_loaded
1:

    rts

save_highscores:
	tst.l	_resload
	bne.b	1f
    tst.b   highscore_needs_saving
    beq.b   1f
    move.l  _dosbase,a6
	bsr.b		get_hiscore_name
    move.l  a0,d1
    move.l  #1006,d2
    jsr     (_LVOOpen,a6)
    move.l  d0,d1
    beq.b   1f
    move.l  d1,d4
    move.l  #SCORE_FILE_SIZE,d3
    move.l  #high_score_buffer,d2
    jsr (_LVOWrite,a6)
    move.l  d4,d1
    jsr (_LVOClose,a6)   
1:	
    rts
    
	
osd_music_stop:
*	movem.l	d0/a0/a6,-(a7)
*	lea		_custom,a6
*	move.w	#3,d0
*	jbsr	_mt_stopfx
*	movem.l	(a7)+,d0/a0/a6

	
	tst.b	music_playing
	jne		force_sound_stop
	rts

force_sound_stop:
	OSD_ENTER
	movem.l	d0-d1/a0/a6,-(a7)
	lea		_custom,a6
	move.b	#-1,music_track_start_number
    clr.w   music_tick   | not playing anymore
	clr.b	music_playing
	clr.l	looped_sound_enabled

    jsr		_mt_end

	movem.l	(a7)+,d0-d1/a0/a6
	OSD_EXIT
	rts
	
* < D0.B sound index
osd_sound_start:
	OSD_ENTER
	movem.l	d0/d1/d2/a0/a1/a6,-(a7)
	lea		_custom,a6
	
	* special case if game starts cut the music that could remain from attract
	cmp.b	#INTRO_36_SND,d0
	jne		0f
	jbsr	osd_music_stop
0:

	moveq	#0,d2
	
	and.w	#0xFF,d0
	lsl.w	#3,d0
	lea		sound_table,a0


	move.w	(a0,d0.w),d1	| sound type
	jeq	11f		| no sound
	cmp.w	#3,d1
	jeq	10f			| mute for now
2:
	cmp.w	#1,d1
	jne	4f		| music module
	move.w	(2,a0,d0.w),d1
	move.l	(4,a0,d0.w),a0
	lea		_custom,a6
	tst		d1
	jeq	3f
	
	* looped sound
	moveq	#0,d0
	move.b	(10,a0),d0		| channel

	lea		looped_sound_enabled,a1
	
	* sound stop
	clr.b	(a1,d0.w)
	movem.l	d0/a0,-(a7)
	jbsr	_mt_stopfx
	movem.l	(a7)+,d0/a0
	tst.b	d2
	jne		10f		| sound stop requested: done
2:
	* now that prev loop is stopped, play the next one
	st.b	(a1,d0.w)
	jbsr		_mt_loopfx
	jra	10f
3:
	jbsr		_mt_playfx
10:
	movem.l	(a7)+,d0/d1/d2/a0/a1/a6
	OSD_EXIT
	rts
11:
	.ifndef	RELEASE
	lsr.w	#3,d0
	move.w	d0,d2
	BREAKPOINT	"unknown sound (in d2)"
	.endif
	jra		10b
12:
	* stop all sounds
	jbsr	_mt_end
	jra		10b
	
	* music
4:
	* if map music, set flag
	cmp.w	#LEVEL_START_TUNE_SND*8,d0
	jne		50f
	* next tune will have to wait for this tune to end
	st.b	wait_for_map_music_end
50:
	cmp.w	#LEVEL12_TUNE_SND*8,d0
	jne		60f
	tst.b	wait_for_map_music_end
	jeq		60f
	st.b	play_level_1_tune_after_music_stop
	jra		6f		| don't play now
60:

	jbsr	load_music_if_needed
	
	* don't play if already playing
	* (music_tick value is not important for looped tunes
	* as long as it's not zero)


	* here we allow music to override another looping music
	*tst.w	music_tick
	*bne.b	10b
	* play the proper module pattern
	* load up the countdown if loop
		

    movem.l d0-a6,-(a7)
	bsr		force_sound_stop
    lea _custom,a6
 	movem.l	d0/a0,-(a7)
	
	move.w	(2,a0,d0.w),d1	| pattern number in .mod file
	lea		module_buffer,a0
	moveq	#0,d0
	move.w	d1,d0
    sub.l   a1,a1		| samples are in the module
    jsr _mt_init
	movem.l	(a7)+,d0/a0

    * set master volume a little less loud if needed
	move.b	(6,a0,d0.w),music_volume
	*move.b	(7,a0,d0.w),music_loops
	*move.w	(4,a0,d0.w),d2

	*move.w	d2,music_duration
	*move.w	d2,music_tick

    moveq	#0,d0
	move.b	music_volume,d0
    jsr	_mt_mastervol
	st.b	music_playing
    jsr _mt_start
5:
    movem.l (a7)+,d0-a6
	
6:
	jra	10b
no_tune:
	movem.l	(a7)+,d0/a0
	jra		5b
	
load_music_if_needed:
	movem.l	d0/a0/a1,-(a7)
	tst.b	no_level_music_flag
	jeq		0f
	* no music: don't load level tunes
 	lea		cd32_music,a0
	cmp.w	#LEVEL12_TUNE_SND*8,d0
	jeq		70f
	cmp.w	#LEVEL34_TUNE_SND*8,d0
	jeq		70f
	cmp.w	#LEVEL56_TUNE_SND*8,d0
	jeq		70f
	cmp.w	#BOSS7_RESOLVE_TUNE_SND*8,d0
	jeq		70f
	jra		1f
0:
 	lea		level_12_music,a0
	cmp.w	#LEVEL12_TUNE_SND*8,d0
	jeq		70f
	lea		level_34_music,a0
	cmp.w	#LEVEL34_TUNE_SND*8,d0
	jeq		70f
	lea		level_56_music,a0
	cmp.w	#LEVEL56_TUNE_SND*8,d0
	jeq		70f
	lea		level_7_music,a0
	cmp.w	#BOSS7_RESOLVE_TUNE_SND*8,d0
	jeq		70f
1:
	lea		first_place_music,a0
	cmp.w	#FIRST_PLACE_TUNE_SND*8,d0
	jeq		70f
	lea		first_place_jingle_music,a0
	cmp.w	#FIRST_PLACE_JINGLE_TUNE_SND*8,d0
	jeq		70f
	lea		second_place_jingle_music,a0
	cmp.w	#SECOND_PLACE_JINGLE_TUNE_SND*8,d0
	jeq		70f
	lea		second_place_music,a0
	cmp.w	#SECOND_PLACE_TUNE_SND*8,d0
	jeq		70f
	jra		75f
70:
	cmp.l	current_music_name,a0
	jeq		75f
	* stop current music if any
	jbsr	osd_music_stop
	
	move.l	a0,current_music_name
	lea		module_buffer,a1
	move.l	#BIGGEST_MUSIC_SIZE,d0
	jbsr	load_file
75:
	movem.l	(a7)+,d0/a0/a1
	rts
	
* all level modules have the same structure but in fact not atm...
* 0-9              stage music + boss
* 10               empty block in loop      
* 11               low time                 
* 12               death                    
* 13               MAP                     
* 14-15          game over                
* 16-17          Key         
* 
* (only last boss mod)             
* 16                bad ending
* 17-22           good ending
	

quit_to_os:
	tst.l	_resload
	bne.b	0f
	jbsr		restore_system
	* set SR to 0 from here, so we return to OS with SR=0
	* (else it kills the system pretty quickly)
	* it works as quit_to_os is called from an interrupt
	move.w	#0,SR
	move.l	old_stack,a7
	*jbsr		save_highscores
	moveq	#0,d0
	rts
0:
	pea	  TDREASON_OK
	move.l	_resload,-(a7)
	addq.l	#resload_Abort,(a7)
	rts




* < A0: filename
* > D0: size (decrunch supported)
get_file_size:
	tst.l	_resload
	jeq		0f
	movem.l	d1/a0-a2,-(a7)
	move.l	_resload,a2
	jbsr	(resload_GetFileSizeDec,a2)
	movem.l	(a7)+,d1/a0-a2
	rts
0:
	* unsupported
	BREAKPOINT	"non-whdload mode unsupported"
	rts


* zero all registers even 6809 stack pointer
* (some games use stack pointer manually for auto variables)
cpu_init:
	moveq	#0,d0
	moveq	#0,d1
	moveq	#0,d2
	moveq	#0,d3
	moveq	#0,d4
	moveq	#0,d6
	moveq	#0,d7
	rts	
	
	.ifndef	RELEASE
scrollx_text:
	.ascii	"Game ScrollX "
	.byte	0xff
hscrollx_text:
	.ascii	"Host ScrollX "
	.byte	0xff
scrolly_text:
	.ascii	"Game ScrollY "
	.byte	0xff	
last_x_offset_text:
	.ascii	"Last Xoffset "
	.byte	0xff
debug_1_text:
	.ascii	"User 1 "
	.byte	0xff
debug_2_text:
	.ascii	"User 2 "
	.byte	0xff
debug_3_text:
	.ascii	"User 3 "
	.byte	0xff


	.align	2
* < D0.W address of value to display (like this it is watched at each irq)
* < D1.W slot (0-3)
osd_display_value:
	movem.l	a0/d1,-(a7)
	lea		display_slots,a0
	and.w	#3,d1
	add.w	d1,d1
	add.w	d1,d1
	add.w	d1,a0
	st.b	(a0)
	move.w	d0,(2,a0)
	movem.l	(a7)+,a0/d1
	rts
	
display_slots:
	.long	0
	.long	0
	.long	0
	.long	0
	.endif
	
	.ifne	OPT_ENABLE_LOGGING

osd_get_last_known_pc:
	move.w	last_known_m6809_pc,d6
	rts
	
	
* < D6: 0 disable, 1 enable, 2 reenable (restore state before disable)
* 2 is useful because you can 1) disable and 2) reenable
* if was not already enabled, reenable will do nothing
osd_cpu_logging_control:
	cmp.b	#2,d6
	jeq		1f
	* it's essential that we skip a second enable while active
	* or disable while inactive
	* else it kills the "reenable" feature, overwriting previous
	cmp.b	cpu_log_enable,d6
	jeq		2f		| enabled/disabled twice: skip
	* 0 or 1: save previous state	
	move.b	cpu_log_enable,cpu_log_prev_state
	move.b	d6,cpu_log_enable
	rts
1:
	* 2: reenable: put previous state, reenabling if needed
	move.b	cpu_log_prev_state,cpu_log_enable
2:
	rts
	
	.macro	CHECK_ZERO_MSW	reg
	swap	\reg
	tst		\reg
	jeq		0f
	move.w	(6,a7),d6
	swap	\reg
	BREAKPOINT		"\reg MSW is not zero, PC=check d6!"
0:
	swap	\reg
	.endm

	
osd_log_cpu:
	OSD_ENTER
	* first, check that registers don't have a wrong longword mask
	CHECK_ZERO_MSW	d1		| D
	CHECK_ZERO_MSW	d2		| X
	CHECK_ZERO_MSW	d3		| Y
	CHECK_ZERO_MSW	d4		| U
	CHECK_ZERO_MSW	d5		| S

*	check that stack is in RAM
*   we had to disable it because at some point the game uses
*   puls/pulu to read data
*	cmp.l	#0x3000,d5
*	jcs		0f
*	BREAKPOINT	"target stack is not in RAM"
*0:
	move.w	(6,a7),last_known_m6809_pc
	
	move.w	last_known_m6809_pc,0x100
	
	move.l	a6,-(a7)
	* check if cpu log is enabled
	tst.b	cpu_log_enable
	jeq		445f
	COLOR0_FLASH	0x0F0

	move.l	log_ptr,a6
	move.w	(10,a7),(a6)+	| the PC
	move.l	d1,-(a7)
	rol.w	#8,d1
	move.b	d0,d1
	rol.w	#8,d1   | make D, make sure that not too many diffs
	move.w	d0,(a6)+
	move.w	d1,(a6)+
	move.w	d2,(a6)+
	move.w	d3,(a6)+
	move.w	d4,(a6)+
	move.w	#0xDEAD,(a6)+
	move.l	a6,log_ptr
	cmp.w	#0xCAFE,(a6)  | hitting the protection buffer
	jne		444f
	BREAKPOINT	"cpu log buffer full, dumping and exiting!"
	jbsr	osd_dump_logs
	illegal
444:
	move.l	(a7)+,d1
445:
	move.l	(a7)+,a6
	OSD_EXIT
	rts

osd_dump_logs:
	OSD_ENTER
	move.w	sr,-(a7)
	move.w	#0x2700,SR
	movem.l	d0-a6,-(a7)
	
	jbsr	save_cpu_log

	move.l	_resload,a2
	lea		fg_tile_log_table,a1
	lea		fg_tile_log_name(pc),a0
	move.l	#FG_TILE_LOG_LENGTH,d0
	jbsr	resload_SaveFile(a2)
	
	lea		bg_tile_log_table,a1
	lea		bg_tile_log_name(pc),a0
	move.l	#BG_TILE_LOG_LENGTH,d0
	jbsr	resload_SaveFile(a2)
	
	lea		sprite_log_table,a1
	lea		sprite_log_name(pc),a0
	move.l	#SPRITE_LOG_LENGTH,d0
	jbsr	resload_SaveFile(a2)
	
	GET_MEMORY_START_IN_A6
	lea		(SPRITE_ADDRESS,a6),a1
	lea		sprite_mem_name(pc),a0
	move.l	#SPRITE_BUFFER_SIZE,d0
	jbsr	resload_SaveFile(a2)
	
	
    movem.l (a7)+,d0-a6
	move.w	(a7)+,SR
	OSD_EXIT
	rts


save_cpu_log:
	move.l	_resload,a2
	lea		log_buffer,a1
	move.l	log_ptr,d0
	sub.l	a1,d0
	jeq		0f
	move.l	log_ptr,a0
	* add RAM & ROM base in the end
	move.l	a6,(a0)+
	move.l	#rom_base,(a0)+
	addq	#8,d0
	lea		cpu_log_name(pc),a0
	jbsr	resload_SaveFile(a2)
0:	
	rts


cpu_log_name:
