OPT_BLIT_CHAIN_MODE = 0		| enable blitter chaining
OPT_VBLIT_MIRROR_MODE = 1		| we need to mirror sprites on the fly, just before blitting them if needed
OPT_VBLIT_SCROLL_MODE = 1		| we need to store scrolling values else BOBs can shake


	.ifne	OPT_CD32_VERSION
boot:
	bra.w	start	| don't optimize to bra.b or jra!!
	* 2 functions that need to be at 4, 8
_cdplay:
	.long	0	| cd32load slave writes the address of the play routine here
_cdstop:
	.long	0	| cd32load slave writes the address of the stop routine here
_cdstatus:
	.long	0	| cd32load slave writes the address of the status routine here
				| 0: cd playing
				| 1: cd stopped playing
				| 2: cd not started playing
				| 3: error
_cdreplay:
	.long	0	| slave cd32load writes the address of the play-if-play-ended routine here
	.endif
start:
	move.l	a7,old_stack
	jra		_user

	.include "../src/options.inc"
	
 
	
	.include "hardware/custom.i"
	.include "lvo/exec_lvos.i"
