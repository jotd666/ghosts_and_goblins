	.include "sounds.inc"
	.include "data.inc"
	.include "utility_macros.inc"
	
AttnFlags = 0x128
AFB_68010 = 0
AFB_68020 = 1

*NO68020 = 1


NB_PLAYFIELD_PLANES = 6  | this is externally defined!!
