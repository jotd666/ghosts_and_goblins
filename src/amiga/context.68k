* generated by find_different_colors.py, then updated by hand for special cases
* if color index matches the encoded value (RGB4 0 padded like in the game)
* then it has to be the following context index, lookup name in the table
* note that level 1 and level 2 share the exact same palette
unique_color_index:
	.word	39
context_data:
	.word	0x08a0  | rgb for color 39, context level1 or 2 (start of level 2)
	.word	0  | context index
	.word	0x0054  | rgb for color 39, context 2 (mid level 2 has different color)
	.word	0  | context index
	.word	0x0b30  | rgb for color 39, context level3
	.word	2  | context index
	.word	0x0f70  | rgb for color 39, context level4
	.word	3  | context index
	.word	0x0444  | rgb for color 39, context level5
	.word	4  | context index
	.word	0x0b9a  | rgb for color 39, context level6
	.word	5  | context index
	.word	0x0600  | rgb for color 39, context level7
	.word	6  | context index
	.word	0x0bbb  | rgb for color 39, context map
	.word	7  | context index
	.word	0x0790 | rgb for color 39, context intro fade 1 10% darker
	.word	0x100  | context index
	.word	0x0680  | rgb for color 39, context intro fade 2 25% darker
	.word	0x101  | context index
	.word	0x0  | rgb for color 39, context intro fade 3 full dark
	.word	0x102  | context index
	.word	-1

tile_context_name_table:
	.long	level1_tiles_path
	.long	level2_tiles_path
	.long	level3_tiles_path
	.long	level4_tiles_path
	.long	level5_tiles_path
	.long	level6_tiles_path
	.long	level7_tiles_path
	.long	map_tiles_path

sprite_context_name_table:
	.long	level1_sprites_path
	.long	level2_sprites_path
	.long	level3_sprites_path
	.long	level4_sprites_path
	.long	level5_sprites_path
	.long	level6_sprites_path
	.long	level7_sprites_path

level1_tiles_path:
	.asciz	"level1_tiles"
level2_tiles_path:
	.asciz	"level2_tiles"
level3_tiles_path:
	.asciz	"level3_tiles"
level4_tiles_path:
	.asciz	"level4_tiles"
level5_tiles_path:
	.asciz	"level5_tiles"
level6_tiles_path:
	.asciz	"level6_tiles"
level7_tiles_path:
	.asciz	"level7_tiles"
map_tiles_path:
	.asciz	"map_tiles"
	
level1_sprites_path:
	.asciz	"level1_sprites"
level2_sprites_path:
	.asciz	"level2_sprites"
level3_sprites_path:
	.asciz	"level3_sprites"
level4_sprites_path:
	.asciz	"level4_sprites"
level5_sprites_path:
	.asciz	"level5_sprites"
level6_sprites_path:
	.asciz	"level6_sprites"
level7_sprites_path:
	.asciz	"level7_sprites"

	.align	2
